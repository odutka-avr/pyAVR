<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Room Data Setup" Width="460"
        SizeToContent="Height" MaxHeight="900"
        WindowStartupLocation="CenterScreen">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="15">

            <!-- SECTION 0: Area rounding -->
            <StackPanel Margin="0,0,0,15">
                <TextBlock Text="0. Area Rounding (decimal places)"
                        FontWeight="Bold" FontSize="13" Margin="0,0,0,6"/>
                <StackPanel Orientation="Horizontal">
                    <Slider x:Name="slider_rounding"
                            Minimum="0" Maximum="3"
                            Value="2"
                            Width="250"
                            IsSnapToTickEnabled="True"
                            TickFrequency="1"
                            SmallChange="1"
                            ValueChanged="on_rounding_changed"
                            VerticalAlignment="Center"/>
                    <TextBlock x:Name="lbl_rounding_value"
                            Text="2"
                            Margin="10,0,0,0"
                            FontSize="13"
                            VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>

            <!-- SECTION 1: Design Option -->
            <TextBlock Text="1. Select Design Option"
                       FontWeight="Bold" FontSize="13" Margin="0,0,0,6"/>
            <ComboBox x:Name="combo_do" Height="28"
                      SelectionChanged="on_do_selected"/>

            <!-- Loading indicator -->
            <TextBlock x:Name="lbl_loading" Foreground="Gray"
                       Visibility="Collapsed" Margin="0,6,0,0"/>

            <!-- SECTION 2: Room Type Coefficients -->
            <StackPanel x:Name="panel_room_types" Visibility="Collapsed" Margin="0,15,0,0">
                <TextBlock Text="2. Room Type Coefficients"
                           FontWeight="Bold" FontSize="13" Margin="0,0,0,6"/>
                <ItemsControl x:Name="items_room_types">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="100"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Label}"
                                           VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1"
                                         Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                         HorizontalContentAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- SECTION 3: Per-building widths -->
            <StackPanel x:Name="panel_finish_width" Visibility="Collapsed" Margin="0,15,0,0">
                <TextBlock Text="3. Finish Layer Width"
                            FontWeight="Bold" FontSize="13" Margin="0,0,0,6"/>
                
                <StackPanel x:Name="choice_building_section" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Different width per building?"
                                VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <RadioButton x:Name="radio_buildings_yes" Content="Yes"
                                    Checked="on_buildings_yes"
                                    VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <RadioButton x:Name="radio_buildings_no" Content="No"
                                    Checked="on_buildings_no"
                                    VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>

                <ItemsControl x:Name="items_building_sections" Visibility="Collapsed">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0, 4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="100"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Label}"
                                           VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1"
                                         Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                         HorizontalContentAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel x:Name="panel_global_width" Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="100"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Global finish layer width (mm)"
                               VerticalAlignment="Center"/>
                    <TextBox x:Name="txt_global_width" Grid.Column="1"
                             Text="0" HorizontalContentAlignment="Center"/>
                </Grid>
            </StackPanel>

            </StackPanel>


            <!-- SECTION 4: Omit Categories -->
            <StackPanel x:Name="panel_categories" Visibility="Collapsed" Margin="0,15,0,0">
                <TextBlock Text="4. Omit Categories from Calculation"
                           FontWeight="Bold" FontSize="13" Margin="0,0,0,6"/>
                <TextBlock Text="Check categories to exclude:"
                           Foreground="Gray" FontSize="11" Margin="0,0,0,6"/>
                <ItemsControl x:Name="items_categories">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <CheckBox Content="{Binding Label}"
                                      IsChecked="{Binding IsChecked}"
                                      Margin="0,3"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- Error + Confirm -->
            <TextBlock x:Name="lbl_error" Foreground="Red"
                       Visibility="Collapsed" Margin="0,10,0,0"
                       TextWrapping="Wrap"/>

            <StackPanel x:Name="panel_confirm" Visibility="Collapsed">
                <Button Content="Confirm" Click="on_confirm"
                        Height="32" Margin="0,15,0,5"/>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Window>