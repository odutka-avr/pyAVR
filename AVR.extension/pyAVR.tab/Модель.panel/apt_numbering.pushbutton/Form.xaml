<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Apartment Numbering"
    Width="420"
    SizeToContent="Height"
    WindowStartupLocation="CenterScreen"
    ResizeMode="NoResize"
    FontFamily="Segoe UI"
    FontSize="13"
    Background="#F5F5F5">

    <StackPanel Margin="20">

        <!-- ── TITLE ──────────────────────────────────────────────── -->
        <TextBlock Text="Категоризація Rooms"
                   FontSize="16"
                   FontWeight="Bold"
                   Margin="0,0,0,16"/>

        <!-- ── BUILDING NAME ──────────────────────────────────────── -->
        <TextBlock Text="Модель:"
                   Margin="0,0,0,4" FontWeight="Bold"/>
        <TextBlock x:Name="TxtBuildingName"
                   Foreground="#555"
                   FontWeight="Normal"
                   Margin="0,0,0,8"
                   TextTrimming="CharacterEllipsis"/>

        <!-- ── DESIGN OPTION ──────────────────────────────────────── -->
        <TextBlock Text="Дизайн опція:"
                   Margin="0,5,0,4" FontWeight="Bold"/>
        <ComboBox x:Name="DoCombo"
                  Height="26"
                  FontSize="13"
                  Margin="0,0,0,16" BorderBrush="White">
        </ComboBox>


        <StackPanel Background="#FFE8DEFF" Margin="0,10,0,10">
            <TextBlock Text="Нумерація"
                       VerticalAlignment="Center"
                       Margin="10,5,10,10" FontWeight="Bold" FontSize="16"/>

            <!-- ── START NUMBER APTS ────────────────────────────────────── -->
            <StackPanel Orientation="Vertical" Margin="5,0,5,5" Background="#FFD6C7FF">
                <TextBlock Text="Квартири"
                    VerticalAlignment="Center"
                    Margin="10,5,10,5" FontWeight="Bold"/>
                <StackPanel Orientation="Horizontal" Margin="10,0,0,5">
                    <TextBlock Text="Почати з:"
                         VerticalAlignment="Center"
                         Margin="0,0,10,0"/>
                    <TextBox x:Name="TxtStartNumberApts"
                         Text="1"
                         Width="60"
                         Height="26"
                         Padding="4,3"
                         VerticalContentAlignment="Center"/>
                </StackPanel>

                <!-- ── CLOCKWISE/COUNTER CLOCKWISE ────────────────────────── -->
                <StackPanel Orientation="Horizontal" Margin="10,0,0,5">
                    <TextBlock Text="За годинниковою стрілкою? ↻"
                        VerticalAlignment="Center"
                        Margin="0,0,10,0"/>
                    <CheckBox x:Name="CheckDirection"
                        IsChecked="True"
                        Width="60"
                        Height="26"
                        Padding="4,3"
                        VerticalContentAlignment="Center"/>
                </StackPanel>
            </StackPanel>
            

            <!-- ── START NUMBER COMMERCE ────────────────────────────────── -->
            <StackPanel Orientation="Vertical" Margin="5,0,5,5" Background="#FFD6C7FF">
                <TextBlock Text="Комерція"
                           VerticalAlignment="Center"
                           Margin="10,5,10,5" FontWeight="Bold"/>
                <StackPanel Orientation="Horizontal" Margin="10,0,0,10">
                    <TextBlock Text="Почати з:"
                        VerticalAlignment="Center"
                        Margin="0,0,10,0"/>
                    <TextBox x:Name="TxtStartNumberCommerce"
                         Text="1000"
                         Width="60"
                         Height="26"
                         Padding="4,3"
                         VerticalContentAlignment="Center"/>
                </StackPanel>
            </StackPanel>

            <!-- ── START NUMBER Storage ──────────────────────────────── -->
            <StackPanel Orientation="Vertical" Margin="5,0,5,5" Background="#FFD6C7FF">
                <TextBlock Text="Комірки"
                           VerticalAlignment="Center"
                           Margin="10,5,10,5" FontWeight="Bold"/>
                <StackPanel Orientation="Horizontal" Margin="10,0,0,10">
                    <TextBlock Text="Почати з:"
                        VerticalAlignment="Center"
                        Margin="0,0,10,0"/>
                    <TextBox x:Name="TxtStartNumberStorage"
                        Text="100"
                        Width="60"
                        Height="26"
                        Padding="4,3"
                        VerticalContentAlignment="Center"/>
                </StackPanel>
            </StackPanel>

        </StackPanel>

        <!-- ── FOOTER ─────────────────────────────────────────────── -->
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button x:Name="BtnRun"
                    Content="Запустити"
                    Width="80" Height="28"/>
        </StackPanel>

    </StackPanel>
</Window>
