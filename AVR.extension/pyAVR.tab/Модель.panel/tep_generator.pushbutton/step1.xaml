<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ТЕП — Генерація таблиці"
        Width="700" SizeToContent="Height"
        WindowStartupLocation="CenterScreen">
    
    <StackPanel>

        <!-- ################## DO SELECTOR ################## -->
        <StackPanel x:Name="DOSelect" Margin="8">

            <TextBlock Text="Вибір документів та дизайн-опцій" 
                        Margin="0,0,0,8"
                        FontSize="14px"
                        FontWeight="Bold"/>

            <!-- column headers -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="180"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="1" Text="Документ"/>
                <TextBlock Grid.Column="2" Text="Дизайн-опція"/>
            </Grid>

            <!-- doc rows list -->
            <ItemsControl x:Name="DocList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,4,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="180"/>
                            </Grid.ColumnDefinitions>

                            <CheckBox Grid.Column="0"
                                        IsChecked="{Binding IsSelected}"
                                        VerticalAlignment="Center"/>

                            <TextBlock Grid.Column="1"
                                        Text="{Binding Name}"
                                        VerticalAlignment="Center"
                                        TextTrimming="CharacterEllipsis"
                                        ToolTip="{Binding Name}"/>

                            <ComboBox Grid.Column="2"
                                        ItemsSource="{Binding DesignOptions}"
                                        DisplayMemberPath="name"
                                        SelectedItem="{Binding SelectedDesignOption}"
                                        IsEnabled="{Binding IsSelected}"
                                        SelectionChanged="OnDesignOptionChanged"/>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- CONFIRM DO -->
            <Grid Margin="0,8,0,0">

                <Button x:Name="BtnConfirm"
                        Grid.Column="1"
                        Content="Підтвердити та парсити"
                        IsEnabled="True"
                        Click="OnConfirmDO"/>
            </Grid>
        </StackPanel>

        <!-- ################## B ID AND B SECTION VALIDATION ################## -->
        <StackPanel x:Name="BValidation" Margin="8">

                <TextBlock Text="Перевірка номерів будівель та черг"
                            Margin="0,0,0,8"
                            FontSize="14px"
                            FontWeight="Bold"/>

                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="160"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Модель"/>
                    <TextBlock Grid.Column="1" Text="№ будівлі" Margin="8,0,0,0"/>
                    <TextBlock Grid.Column="2" Text="№ черги"   Margin="8,0,0,0"/>
                </Grid>

                <ItemsControl x:Name="BuildingList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,4,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="160"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                        Text="{Binding name}"
                                        VerticalAlignment="Center"
                                        TextTrimming="CharacterEllipsis"
                                        ToolTip="{Binding name}"/>

                                <TextBox Grid.Column="1"
                                        Text="{Binding b_number}"
                                        Margin="8,0,0,0"
                                        TextChanged="OnBNumberChanged"/>

                                <TextBox Grid.Column="2"
                                        Text="{Binding b_dev_phase}"
                                        Margin="8,0,0,0"
                                        TextChanged="OnBDevPhaseChanged"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Button x:Name="BtnConfirmB"
                        Content="Підтвердити"
                        Margin="0,8,0,0"
                        Click="OnConfirmB"/>

        </StackPanel>
    
        <!-- ################## MANUAL FIELD FILLING ################## -->
        <StackPanel x:Name="FieldFill" Margin="12,16,12,12">
        
            <TextBlock Text="Заповнення додаткових полів"
                        Margin="0,0,0,12" 
                        FontWeight="Bold" 
                        FontSize="14px"/>

            <StackPanel Margin="0,0,0,16">
                <TextBlock Text="Перевірка найменування проекту і адреси" 
                            FontWeight="Bold"
                            Margin="0,0,0,8"/>
                
                <StackPanel Margin="0,0,0,8">
                    <!-- ROW 1 -->
                    <StackPanel Margin="0,0,0,4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                    Text="Найменування"
                                    VerticalAlignment="Center"/>

                            <TextBox Grid.Column="1"
                                    x:Name="ProjectName"
                                    TextChanged="OnProjectNameChanged"
                                    TextWrapping="Wrap"
                                    AcceptsReturn="True"/>
                        </Grid>
                    </StackPanel>

                    <!-- ROW 2 -->
                    <StackPanel Margin="0,0,0,4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                    Text="Адреса"
                                    VerticalAlignment="Center"/>

                            <TextBox Grid.Column="1"
                                    x:Name="ProjectAddress"
                                    TextChanged="OnProjectAddressChanged"
                                    TextWrapping="Wrap"
                                    AcceptsReturn="True"/>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <!-- ONE unified ItemsControl - much more stable -->
            <TextBlock Text="Параметри по будівлях" 
                    FontWeight="Bold" 
                    Margin="0,0,0,12"/>
            
            <!-- column headers — outside DataTemplate -->
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="60"/>
                    <ColumnDefinition Width="60"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="2" 
                        Text="Гранична висота (м)" 
                        FontWeight="SemiBold"
                        TextWrapping="Wrap"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        TextAlignment="Center"/>
                <TextBlock Grid.Column="3" 
                        Text="Ступінь вогнестійкості" 
                        FontWeight="SemiBold"
                        TextWrapping="Wrap"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        TextAlignment="Center"/>
                <TextBlock Grid.Column="4" 
                        Text="Клас енергоефективності" 
                        FontWeight="SemiBold"
                        TextWrapping="Wrap"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        TextAlignment="Center"/>
                <TextBlock Grid.Column="5" 
                        Text="Тривалість будівництва" 
                        FontWeight="SemiBold"
                        TextWrapping="Wrap"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        TextAlignment="Center"/>
            </Grid>

            <ItemsControl x:Name="ManualParamsList" Margin="0,0,0,16">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,8,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="60"/>   <!-- Черга -->
                                <ColumnDefinition Width="60"/>   <!-- Будинок -->
                                <ColumnDefinition Width="*"/>  <!-- Висота -->
                                <ColumnDefinition Width="*"/>  <!-- Вогнестійкість -->
                                <ColumnDefinition Width="*"/>  <!-- Клас енергоефективності -->
                                <ColumnDefinition Width="*"/>  <!-- Тривалість -->
                            </Grid.ColumnDefinitions>

                            <!-- Labels -->
                            <TextBlock Grid.Column="0" 
                                    Text="{Binding dev_phase_id, StringFormat='Черга: {0}'}" 
                                    VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Grid.Column="1" 
                                    Text="{Binding building_id, StringFormat='Буд: {0}'}" 
                                    VerticalAlignment="Center" Margin="0,0,12,0"/>

                            <!-- Height -->
                            <TextBox Grid.Column="2"
                                    Tag="Height" 
                                    TextChanged="OnHeightChanged"
                                    Width="90" Margin="4,0"/>

                            <!-- Fire Rating -->
                            <TextBox Grid.Column="3" 
                                    TextChanged="OnFireRatingChanged"
                                    Width="130" Margin="4,0"/>

                            <!-- Energy Class -->
                            <TextBox Grid.Column="4" 
                                    TextChanged="OnEnergyClassChanged"
                                    Width="150" Margin="4,0"/>

                            <!-- Duration -->
                            <TextBox Grid.Column="5" 
                                    TextChanged="OnDurationChanged"
                                    Width="130" Margin="4,0"/>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            
            <Button x:Name="BtnConfirmManualData"
                        Content="Підтвердити"
                        Margin="0,8,0,0"
                        Click="OnConfirmManualData"/>

        </StackPanel>

    </StackPanel>

</Window>
