<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Перенумерувати" Height="450" Width="360"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <FontFamily x:Key="AppFont">Tahoma</FontFamily>

        <SolidColorBrush x:Key="AccentBrush"           Color="#6D5DFB"/>
        <SolidColorBrush x:Key="TableBackgroundBrush"  Color="#181818"/>
        <SolidColorBrush x:Key="TableBorderBrush"      Color="#55555A"/>
        <SolidColorBrush x:Key="HeaderTextBrush"       Color="#55555A"/>
        <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#090A0A"/>
        <SolidColorBrush x:Key="ApplyButtonBgBrush"    Color="#573F85"/>
        <SolidColorBrush x:Key="ErrorTextBrush"        Color="#E52320"/>
        <SolidColorBrush x:Key="RowPillBrush"          Color="#262626"/>
        <SolidColorBrush x:Key="ScrollBarBrush"        Color="#55555A"/>

        <!-- ═══════ ВЕРТИКАЛЬНИЙ СКРОЛБАР ═══════ -->
        <ControlTemplate x:Key="VerticalScrollBarTemplate" TargetType="ScrollBar">
            <Grid Width="14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <RepeatButton Grid.Row="0" Height="14" Command="ScrollBar.LineUpCommand" Background="Transparent" BorderThickness="0">
                    <RepeatButton.Template>
                        <ControlTemplate TargetType="RepeatButton">
                            <Path Data="M 4,9 L 7,4 L 10,9 Z" Width="8" Height="6" Stretch="Uniform"
                                  Fill="{StaticResource ScrollBarBrush}" Stroke="{StaticResource ScrollBarBrush}"
                                  StrokeThickness="2" StrokeLineJoin="Round"/>
                        </ControlTemplate>
                    </RepeatButton.Template>
                </RepeatButton>

                <Track Grid.Row="1" Name="PART_Track" IsDirectionReversed="True">
                    <Track.DecreaseRepeatButton>
                        <RepeatButton Command="ScrollBar.PageUpCommand" Background="Transparent" BorderThickness="0"/>
                    </Track.DecreaseRepeatButton>
                    <Track.IncreaseRepeatButton>
                        <RepeatButton Command="ScrollBar.PageDownCommand" Background="Transparent" BorderThickness="0"/>
                    </Track.IncreaseRepeatButton>
                    <Track.Thumb>
                        <Thumb>
                            <Thumb.Template>
                                <ControlTemplate TargetType="Thumb">
                                    <Border Background="{StaticResource ScrollBarBrush}" CornerRadius="7" Width="8" Margin="3,0"/>
                                </ControlTemplate>
                            </Thumb.Template>
                        </Thumb>
                    </Track.Thumb>
                </Track>

                <RepeatButton Grid.Row="2" Height="14" Command="ScrollBar.LineDownCommand" Background="Transparent" BorderThickness="0">
                    <RepeatButton.Template>
                        <ControlTemplate TargetType="RepeatButton">
                            <Path Data="M 4,4 L 10,4 L 7,9 Z" Width="8" Height="6" Stretch="Uniform"
                                  Fill="{StaticResource ScrollBarBrush}" Stroke="{StaticResource ScrollBarBrush}"
                                  StrokeThickness="2" StrokeLineJoin="Round"/>
                        </ControlTemplate>
                    </RepeatButton.Template>
                </RepeatButton>
            </Grid>
        </ControlTemplate>

        <!-- ═══════ ГОРИЗОНТАЛЬНИЙ СКРОЛБАР ═══════ -->
        <ControlTemplate x:Key="HorizontalScrollBarTemplate" TargetType="ScrollBar">
            <Grid Height="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <RepeatButton Grid.Column="0" Width="14" Command="ScrollBar.LineLeftCommand" Background="Transparent" BorderThickness="0">
                    <RepeatButton.Template>
                        <ControlTemplate TargetType="RepeatButton">
                            <Path Data="M 9,4 L 4,7 L 9,10 Z" Width="6" Height="8" Stretch="Uniform"
                                  Fill="{StaticResource ScrollBarBrush}" Stroke="{StaticResource ScrollBarBrush}"
                                  StrokeThickness="2" StrokeLineJoin="Round"/>
                        </ControlTemplate>
                    </RepeatButton.Template>
                </RepeatButton>

                <Track Grid.Column="1" Name="PART_Track">
                    <Track.DecreaseRepeatButton>
                        <RepeatButton Command="ScrollBar.PageLeftCommand" Background="Transparent" BorderThickness="0"/>
                    </Track.DecreaseRepeatButton>
                    <Track.IncreaseRepeatButton>
                        <RepeatButton Command="ScrollBar.PageRightCommand" Background="Transparent" BorderThickness="0"/>
                    </Track.IncreaseRepeatButton>
                    <Track.Thumb>
                        <Thumb>
                            <Thumb.Template>
                                <ControlTemplate TargetType="Thumb">
                                    <Border Background="{StaticResource ScrollBarBrush}" CornerRadius="7" Height="8" Margin="0,3"/>
                                </ControlTemplate>
                            </Thumb.Template>
                        </Thumb>
                    </Track.Thumb>
                </Track>

                <RepeatButton Grid.Column="2" Width="14" Command="ScrollBar.LineRightCommand" Background="Transparent" BorderThickness="0">
                    <RepeatButton.Template>
                        <ControlTemplate TargetType="RepeatButton">
                            <Path Data="M 4,4 L 9,7 L 4,10 Z" Width="6" Height="8" Stretch="Uniform"
                                  Fill="{StaticResource ScrollBarBrush}" Stroke="{StaticResource ScrollBarBrush}"
                                  StrokeThickness="2" StrokeLineJoin="Round"/>
                        </ControlTemplate>
                    </RepeatButton.Template>
                </RepeatButton>
            </Grid>
        </ControlTemplate>

        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="14"/>
            <Setter Property="MinWidth" Value="14"/>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Vertical">
                    <Setter Property="Template" Value="{StaticResource VerticalScrollBarTemplate}"/>
                </Trigger>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Template" Value="{StaticResource HorizontalScrollBarTemplate}"/>
                    <Setter Property="Height" Value="14"/>
                    <Setter Property="Width" Value="Auto"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
            <Setter Property="Foreground" Value="{StaticResource HeaderTextBrush}"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
            <Setter Property="Background" Value="{StaticResource TableBackgroundBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource TableBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Border Name="RootBorder" CornerRadius="14" Background="{StaticResource WindowBackgroundBrush}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="BorderBrush" Value="Transparent"/>
                    <Setter Property="BorderThickness" Value="2"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=IsActive}" Value="True">
                            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Background="#090A0A"
                      MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Перенумерувати листи"
                               FontSize="14" FontWeight="SemiBold" Foreground="#55555A"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,10"/>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,8,0">
                        <Button Content="—" Width="34" Height="30" FontWeight="Bold" Click="TitleBar_Minimize">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Foreground" Value="{StaticResource TableBorderBrush}"/>
                                </Style>
                            </Button.Style>
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Name="BtnBorder" Background="{TemplateBinding Background}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="BtnBorder" Property="Background" Value="{StaticResource TableBackgroundBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Content="✕" Width="34" Height="30" FontWeight="Bold" Click="TitleBar_Close">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Foreground" Value="{StaticResource TableBorderBrush}"/>
                                </Style>
                            </Button.Style>
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Name="BtnBorder" Background="{TemplateBinding Background}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="BtnBorder" Property="Background" Value="{StaticResource TableBackgroundBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1" Margin="20,20,20,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Name="tb_Counter" Text="Вибрано: 0" FontSize="12" FontWeight="Bold"
                               Foreground="{StaticResource AccentBrush}" Margin="0,0,0,14"/>


                    <Grid Grid.Row="1" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Префікс" FontSize="11" Margin="0,0,0,4"/>
                            <TextBox Name="tb_Prefix" Height="30" TextChanged="OnRenumberFieldChanged"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Width="70">
                            <TextBlock Text="Номер" FontSize="11" Margin="0,0,0,4"/>
                            <TextBox Name="tb_StartNumber" Height="30" TextChanged="OnRenumberFieldChanged"/>
                        </StackPanel>

                        <StackPanel Grid.Column="4">
                            <TextBlock Text="Суфікс" FontSize="11" Margin="0,0,0,4"/>
                            <TextBox Name="tb_Suffix" Height="30" TextChanged="OnRenumberFieldChanged"/>
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="2" Background="{StaticResource TableBackgroundBrush}"
                            BorderBrush="{StaticResource TableBorderBrush}" BorderThickness="1"
                            CornerRadius="10" Margin="0,4,0,20" ClipToBounds="True">
                        <DataGrid Name="lb_RenumberPreview" AutoGenerateColumns="False" IsReadOnly="True"
                                  HeadersVisibility="Column" GridLinesVisibility="None"
                                  Background="Transparent" BorderThickness="0"
                                  RowBackground="Transparent">
                            <DataGrid.Resources>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Foreground" Value="{StaticResource HeaderTextBrush}"/>
                                    <Setter Property="FontSize" Value="12"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Padding" Value="8,8"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                </Style>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Padding" Value="8,6"/>
                                </Style>
                                <Style TargetType="DataGridRow">
                                    <Setter Property="Background" Value="Transparent"/>
                                </Style>
                            </DataGrid.Resources>
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="ДО" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource RowPillBrush}" CornerRadius="12"
                                                    Padding="12,6" Margin="4">
                                                <TextBlock Text="{Binding OldNumber}" Foreground="White" FontSize="13"
                                                           FontWeight="SemiBold" HorizontalAlignment="Left"
                                                           TextWrapping="Wrap" TextAlignment="Left"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="ПІСЛЯ" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource RowPillBrush}" CornerRadius="12"
                                                    Padding="12,6" Margin="4">
                                                <TextBlock Text="{Binding NewNumber}" Foreground="{StaticResource AccentBrush}" FontSize="13"
                                                           FontWeight="SemiBold" HorizontalAlignment="Left"
                                                           TextWrapping="Wrap" TextAlignment="Left"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Name="btn_Cancel" Content="Скасувати" Width="90" Height="34" Margin="0,0,10,0"
                                FontWeight="Bold" Click="ButtonEvent_Cancel">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="{StaticResource TableBackgroundBrush}"/>
                                    <Setter Property="Foreground" Value="{StaticResource HeaderTextBrush}"/>
                                </Style>
                            </Button.Style>
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Name="BtnBorder" Background="{TemplateBinding Background}"
                                            BorderBrush="{StaticResource TableBorderBrush}" BorderThickness="1"
                                            CornerRadius="8">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           TextElement.Foreground="{TemplateBinding Foreground}"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="BtnBorder" Property="BorderBrush" Value="{StaticResource ErrorTextBrush}"/>
                                            <Setter Property="Foreground" Value="{StaticResource ErrorTextBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Button Name="btn_Ok" Content="Перенумерувати" Width="140" Height="34"
                                FontWeight="Bold" BorderThickness="1.5" Click="ButtonEvent_Ok">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="{StaticResource ApplyButtonBgBrush}"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="BorderBrush" Value="Transparent"/>
                                </Style>
                            </Button.Style>
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Name="BtnBorder" Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="8">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           TextElement.Foreground="{TemplateBinding Foreground}"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#F9F9F9"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <Rectangle Fill="Transparent" Height="6" VerticalAlignment="Top" Cursor="SizeNS" Tag="N"
                   MouseLeftButtonDown="ResizeGrip_MouseLeftButtonDown" MouseMove="ResizeGrip_MouseMove" MouseLeftButtonUp="ResizeGrip_MouseLeftButtonUp"/>
        <Rectangle Fill="Transparent" Height="6" VerticalAlignment="Bottom" Cursor="SizeNS" Tag="S"
                   MouseLeftButtonDown="ResizeGrip_MouseLeftButtonDown" MouseMove="ResizeGrip_MouseMove" MouseLeftButtonUp="ResizeGrip_MouseLeftButtonUp"/>
        <Rectangle Fill="Transparent" Width="6" HorizontalAlignment="Left" Cursor="SizeWE" Tag="W"
                   MouseLeftButtonDown="ResizeGrip_MouseLeftButtonDown" MouseMove="ResizeGrip_MouseMove" MouseLeftButtonUp="ResizeGrip_MouseLeftButtonUp"/>
        <Rectangle Fill="Transparent" Width="6" HorizontalAlignment="Right" Cursor="SizeWE" Tag="E"
                   MouseLeftButtonDown="ResizeGrip_MouseLeftButtonDown" MouseMove="ResizeGrip_MouseMove" MouseLeftButtonUp="ResizeGrip_MouseLeftButtonUp"/>
        <Rectangle Fill="Transparent" Width="10" Height="10" HorizontalAlignment="Left" VerticalAlignment="Top" Cursor="SizeNWSE" Tag="NW"
                   MouseLeftButtonDown="ResizeGrip_MouseLeftButtonDown" MouseMove="ResizeGrip_MouseMove" MouseLeftButtonUp="ResizeGrip_MouseLeftButtonUp"/>
        <Rectangle Fill="Transparent" Width="10" Height="10" HorizontalAlignment="Right" VerticalAlignment="Top" Cursor="SizeNESW" Tag="NE"
                   MouseLeftButtonDown="ResizeGrip_MouseLeftButtonDown" MouseMove="ResizeGrip_MouseMove" MouseLeftButtonUp="ResizeGrip_MouseLeftButtonUp"/>
        <Rectangle Fill="Transparent" Width="10" Height="10" HorizontalAlignment="Left" VerticalAlignment="Bottom" Cursor="SizeNESW" Tag="SW"
                   MouseLeftButtonDown="ResizeGrip_MouseLeftButtonDown" MouseMove="ResizeGrip_MouseMove" MouseLeftButtonUp="ResizeGrip_MouseLeftButtonUp"/>
        <Rectangle Fill="Transparent" Width="10" Height="10" HorizontalAlignment="Right" VerticalAlignment="Bottom" Cursor="SizeNWSE" Tag="SE"
                   MouseLeftButtonDown="ResizeGrip_MouseLeftButtonDown" MouseMove="ResizeGrip_MouseMove" MouseLeftButtonUp="ResizeGrip_MouseLeftButtonUp"/>
    </Grid>
</Window>