<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Створити види/листи" Height="600" Width="720"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <FontFamily x:Key="AppFont">Tahoma</FontFamily>

        <SolidColorBrush x:Key="AccentBrush"           Color="#6D5DFB"/>
        <SolidColorBrush x:Key="TableBackgroundBrush"  Color="#181818"/>
        <SolidColorBrush x:Key="TableBorderBrush"      Color="#55555A"/>
        <SolidColorBrush x:Key="HeaderTextBrush"       Color="#55555A"/>
        <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#090A0A"/>
        <SolidColorBrush x:Key="ApplyButtonBgBrush"    Color="#573F85"/>
        <SolidColorBrush x:Key="RowPillBrush"          Color="#262626"/>
        <SolidColorBrush x:Key="ErrorTextBrush"        Color="#E52320"/>
        <SolidColorBrush x:Key="ScrollBarBrush"        Color="#55555A"/>

        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
            <Setter Property="Foreground" Value="{StaticResource HeaderTextBrush}"/>
        </Style>

        <!-- ═══════ ЧИП ТИПУ ВИДУ / ЗАГАЛЬНИЙ ЧИП ═══════ -->
        <Style x:Key="TypeChipStyle" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{StaticResource HeaderTextBrush}"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Name="ChipBorder" CornerRadius="10"
                                Background="Transparent"
                                BorderBrush="{StaticResource TableBorderBrush}" BorderThickness="1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                               TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ChipBorder" Property="Background" Value="#406D5DFB"/>
                                <Setter TargetName="ChipBorder" Property="BorderBrush" Value="Transparent"/>
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ChipBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══════ КРУГЛИЙ ЧЕКБОКС (для вибору рівня) ═══════ -->
        <Style x:Key="PickerCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Name="CheckBoxBorder" Width="16" Height="16" CornerRadius="4"
                                    Background="Transparent"
                                    BorderBrush="{StaticResource TableBorderBrush}" BorderThickness="1.5"
                                    VerticalAlignment="Center">
                                <Path Name="CheckMark" Data="M 3,7 L 6,10 L 12,3"
                                      Stroke="White" StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckBoxBorder" Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="CheckBoxBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══════ COMBOBOX СКОУП-БОКСУ ═══════ -->
        <Style TargetType="ComboBox">
            <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
            <Setter Property="Background" Value="{StaticResource TableBackgroundBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource TableBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Name="ToggleBtn"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="20"/>
                                                </Grid.ColumnDefinitions>
                                                <Path Grid.Column="1" Data="M 4,6 L 8,10 L 12,6"
                                                      Stroke="{StaticResource TableBorderBrush}"
                                                      StrokeThickness="1.5" StrokeLineJoin="Round"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter Name="ContentSite" IsHitTestVisible="False"
                                               Content="{TemplateBinding SelectionBoxItem}"
                                               Margin="8,0,24,0" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                            <Popup Name="Popup" Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Border Background="{StaticResource TableBackgroundBrush}"
                                        BorderBrush="{StaticResource TableBorderBrush}" BorderThickness="1"
                                        CornerRadius="6" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="200">
                                    <ScrollViewer><ItemsPresenter/></ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border Name="ItemBorder" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource TableBorderBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══════ ВЕРТИКАЛЬНИЙ СКРОЛБАР ═══════ -->
        <ControlTemplate x:Key="VerticalScrollBarTemplate" TargetType="ScrollBar">
            <Grid Width="14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <RepeatButton Grid.Row="0" Height="14" Command="ScrollBar.LineUpCommand" Background="Transparent" BorderThickness="0">
                    <RepeatButton.Template>
                        <ControlTemplate TargetType="RepeatButton">
                            <Path Data="M 4,9 L 7,4 L 10,9 Z" Width="8" Height="6" Stretch="Uniform"
                                  Fill="{StaticResource ScrollBarBrush}" Stroke="{StaticResource ScrollBarBrush}"
                                  StrokeThickness="2" StrokeLineJoin="Round"/>
                        </ControlTemplate>
                    </RepeatButton.Template>
                </RepeatButton>

                <Track Grid.Row="1" Name="PART_Track" IsDirectionReversed="True">
                    <Track.DecreaseRepeatButton>
                        <RepeatButton Command="ScrollBar.PageUpCommand" Background="Transparent" BorderThickness="0"/>
                    </Track.DecreaseRepeatButton>
                    <Track.IncreaseRepeatButton>
                        <RepeatButton Command="ScrollBar.PageDownCommand" Background="Transparent" BorderThickness="0"/>
                    </Track.IncreaseRepeatButton>
                    <Track.Thumb>
                        <Thumb>
                            <Thumb.Template>
                                <ControlTemplate TargetType="Thumb">
                                    <Border Background="{StaticResource ScrollBarBrush}" CornerRadius="7" Width="8" Margin="3,0"/>
                                </ControlTemplate>
                            </Thumb.Template>
                        </Thumb>
                    </Track.Thumb>
                </Track>

                <RepeatButton Grid.Row="2" Height="14" Command="ScrollBar.LineDownCommand" Background="Transparent" BorderThickness="0">
                    <RepeatButton.Template>
                        <ControlTemplate TargetType="RepeatButton">
                            <Path Data="M 4,4 L 10,4 L 7,9 Z" Width="8" Height="6" Stretch="Uniform"
                                  Fill="{StaticResource ScrollBarBrush}" Stroke="{StaticResource ScrollBarBrush}"
                                  StrokeThickness="2" StrokeLineJoin="Round"/>
                        </ControlTemplate>
                    </RepeatButton.Template>
                </RepeatButton>
            </Grid>
        </ControlTemplate>

        <!-- ═══════ ГОРИЗОНТАЛЬНИЙ СКРОЛБАР ═══════ -->
        <ControlTemplate x:Key="HorizontalScrollBarTemplate" TargetType="ScrollBar">
            <Grid Height="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <RepeatButton Grid.Column="0" Width="14" Command="ScrollBar.LineLeftCommand" Background="Transparent" BorderThickness="0">
                    <RepeatButton.Template>
                        <ControlTemplate TargetType="RepeatButton">
                            <Path Data="M 9,4 L 4,7 L 9,10 Z" Width="6" Height="8" Stretch="Uniform"
                                  Fill="{StaticResource ScrollBarBrush}" Stroke="{StaticResource ScrollBarBrush}"
                                  StrokeThickness="2" StrokeLineJoin="Round"/>
                        </ControlTemplate>
                    </RepeatButton.Template>
                </RepeatButton>

                <Track Grid.Column="1" Name="PART_Track">
                    <Track.DecreaseRepeatButton>
                        <RepeatButton Command="ScrollBar.PageLeftCommand" Background="Transparent" BorderThickness="0"/>
                    </Track.DecreaseRepeatButton>
                    <Track.IncreaseRepeatButton>
                        <RepeatButton Command="ScrollBar.PageRightCommand" Background="Transparent" BorderThickness="0"/>
                    </Track.IncreaseRepeatButton>
                    <Track.Thumb>
                        <Thumb>
                            <Thumb.Template>
                                <ControlTemplate TargetType="Thumb">
                                    <Border Background="{StaticResource ScrollBarBrush}" CornerRadius="7" Height="8" Margin="0,3"/>
                                </ControlTemplate>
                            </Thumb.Template>
                        </Thumb>
                    </Track.Thumb>
                </Track>

                <RepeatButton Grid.Column="2" Width="14" Command="ScrollBar.LineRightCommand" Background="Transparent" BorderThickness="0">
                    <RepeatButton.Template>
                        <ControlTemplate TargetType="RepeatButton">
                            <Path Data="M 4,4 L 9,7 L 4,10 Z" Width="6" Height="8" Stretch="Uniform"
                                  Fill="{StaticResource ScrollBarBrush}" Stroke="{StaticResource ScrollBarBrush}"
                                  StrokeThickness="2" StrokeLineJoin="Round"/>
                        </ControlTemplate>
                    </RepeatButton.Template>
                </RepeatButton>
            </Grid>
        </ControlTemplate>

        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="14"/>
            <Setter Property="MinWidth" Value="14"/>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Vertical">
                    <Setter Property="Template" Value="{StaticResource VerticalScrollBarTemplate}"/>
                </Trigger>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Template" Value="{StaticResource HorizontalScrollBarTemplate}"/>
                    <Setter Property="Height" Value="14"/>
                    <Setter Property="Width" Value="Auto"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Border Name="RootBorder" CornerRadius="14" Background="{StaticResource WindowBackgroundBrush}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="BorderBrush" Value="Transparent"/>
                    <Setter Property="BorderThickness" Value="2"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=IsActive}" Value="True">
                            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ═══════ ЗАГОЛОВОК ═══════ -->
                <Grid Grid.Row="0" Background="#090A0A" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Створити види/листи"
                               FontSize="14" FontWeight="SemiBold" Foreground="#55555A"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,10"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,8,0">
                        <Button Content="—" Width="34" Height="30" FontWeight="Bold" Click="TitleBar_Minimize">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Foreground" Value="{StaticResource TableBorderBrush}"/>
                                </Style>
                            </Button.Style>
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Name="BtnBorder" Background="{TemplateBinding Background}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="BtnBorder" Property="Background" Value="{StaticResource TableBackgroundBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Content="✕" Width="34" Height="30" FontWeight="Bold" Click="TitleBar_Close">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Foreground" Value="{StaticResource TableBorderBrush}"/>
                                </Style>
                            </Button.Style>
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Name="BtnBorder" Background="{TemplateBinding Background}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="BtnBorder" Property="Background" Value="{StaticResource TableBackgroundBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- ═══════ ЧИПИ: СТВОРИТИ ЛИСТИ / DEPENDENT VIEW ═══════ -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,16,0,0">
                    <ToggleButton Name="cb_CreateSheets" Content="Створити листи для цих видів"
                                  IsChecked="True" Style="{StaticResource TypeChipStyle}"
                                  Padding="12,6" FontSize="11"/>
                    <ToggleButton Name="cb_CreateDependent" Content="Створити Dependent View (стадія)"
                                  IsChecked="False" Style="{StaticResource TypeChipStyle}"
                                  Padding="12,6" FontSize="11"/>
                </StackPanel>

                <!-- ═══════ ТАБЛИЦЯ РІВНІВ ═══════ -->
                <Border Grid.Row="2" Margin="0,16,0,0" Background="{StaticResource TableBackgroundBrush}"
                        BorderBrush="{StaticResource TableBorderBrush}" BorderThickness="1" CornerRadius="10">
                    <Grid Margin="12" Grid.IsSharedSizeScope="True">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="8,0,8,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30"/>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="LevelNameColumn"/>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="1" Text="РІВЕНЬ" FontSize="10" FontWeight="Bold" Margin="0,0,4,0"/>
                            <TextBlock Grid.Column="2" Text="СКОУП-БОКС" FontSize="10" FontWeight="Bold" Margin="0,0,4,0"/>
                            <TextBlock Grid.Column="3" Text="ДОДАТКОВІ ШАБЛОНИ" FontSize="10" FontWeight="Bold" Margin="0,0,4,0"/>
                            <TextBlock Grid.Column="4" Text="ТИПИ ВИДІВ" FontSize="10" FontWeight="Bold"/>
                        </Grid>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl Name="ic_LevelsList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="8,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="30"/>
                                                <ColumnDefinition Width="Auto" SharedSizeGroup="LevelNameColumn"/>
                                                <ColumnDefinition Width="180"/>
                                                <ColumnDefinition Width="150"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <CheckBox Grid.Column="0" IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                      Style="{StaticResource PickerCheckBoxStyle}"
                                                      VerticalAlignment="Center"/>

                                            <TextBlock Grid.Column="1" Text="{Binding LevelName}"
                                                       Foreground="White" FontSize="11" VerticalAlignment="Center"
                                                       Margin="0,0,4,0"/>

                                            <ComboBox Grid.Column="2" Height="28" Margin="0,0,4,0"
                                                      ItemsSource="{Binding ScopeBoxOptions}"
                                                      SelectedItem="{Binding SelectedScopeBox, Mode=TwoWay}"/>

                                            <Grid Grid.Column="3" Margin="0,0,4,0">
                                                <ToggleButton Name="AdditionalTemplatesToggle" Height="28" HorizontalContentAlignment="Left"
                                                              IsChecked="{Binding IsDropdownOpen, Mode=TwoWay}"
                                                              Content="{Binding AdditionalTemplatesSummary}"
                                                              FontSize="10" Foreground="White" Padding="8,0">
                                                    <ToggleButton.Style>
                                                        <Style TargetType="ToggleButton">
                                                            <Setter Property="Template">
                                                                <Setter.Value>
                                                                    <ControlTemplate TargetType="ToggleButton">
                                                                        <Border Background="{StaticResource TableBackgroundBrush}"
                                                                                BorderBrush="{StaticResource TableBorderBrush}" BorderThickness="1" CornerRadius="6">
                                                                            <ContentPresenter VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                                                                        </Border>
                                                                    </ControlTemplate>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </Style>
                                                    </ToggleButton.Style>
                                                </ToggleButton>

                                                <Popup PlacementTarget="{Binding ElementName=AdditionalTemplatesToggle}"
                                                       IsOpen="{Binding IsDropdownOpen, Mode=TwoWay}"
                                                       Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
                                                    <Border Background="{StaticResource TableBackgroundBrush}"
                                                            BorderBrush="{StaticResource TableBorderBrush}" BorderThickness="1"
                                                            CornerRadius="8" Padding="8" MaxHeight="200" MinWidth="220">
                                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                            <ItemsControl ItemsSource="{Binding AdditionalTemplateItems}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <CheckBox Content="{Binding TemplateName}" IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                                                  Style="{StaticResource PickerCheckBoxStyle}" Margin="0,3"
                                                                                  Foreground="White"/>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </ScrollViewer>
                                                    </Border>
                                                </Popup>
                                            </Grid>

                                            <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                                <ToggleButton Content="План" Style="{StaticResource TypeChipStyle}"
                                                              IsChecked="{Binding IsPlanChecked, Mode=TwoWay}"/>
                                                <ToggleButton Content="Мурувальний" Style="{StaticResource TypeChipStyle}"
                                                              IsChecked="{Binding IsMasonryChecked, Mode=TwoWay}"/>
                                            </StackPanel>



                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- ═══════ ФУТЕР ═══════ -->
                <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                    <Button Name="btn_Cancel" Content="Скасувати" Width="110" Height="34" Margin="0,0,10,0"
                            FontWeight="Bold" BorderThickness="1" Click="ButtonEvent_Cancel">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="{StaticResource TableBackgroundBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource HeaderTextBrush}"/>
                                <Setter Property="BorderBrush" Value="{StaticResource TableBorderBrush}"/>
                            </Style>
                        </Button.Style>
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Name="BtnBorder" Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       TextElement.Foreground="{TemplateBinding Foreground}"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="BtnBorder" Property="BorderBrush" Value="{StaticResource ErrorTextBrush}"/>
                                        <Setter Property="Foreground" Value="{StaticResource ErrorTextBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Button Name="btn_Ok" Content="Створити" Width="120" Height="34"
                            FontWeight="Bold" BorderThickness="1.5" Click="ButtonEvent_Ok">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="{StaticResource ApplyButtonBgBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="BorderBrush" Value="Transparent"/>
                            </Style>
                        </Button.Style>
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Name="BtnBorder" Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       TextElement.Foreground="{TemplateBinding Foreground}"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#F9F9F9"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>

            </Grid>
        </Border>

        <Rectangle Fill="Transparent" Height="6" VerticalAlignment="Top" Cursor="SizeNS" Tag="N"
                   MouseLeftButtonDown="ResizeGrip_MouseLeftButtonDown" MouseMove="ResizeGrip_MouseMove" MouseLeftButtonUp="ResizeGrip_MouseLeftButtonUp"/>
        <Rectangle Fill="Transparent" Height="6" VerticalAlignment="Bottom" Cursor="SizeNS" Tag="S"
                   MouseLeftButtonDown="ResizeGrip_MouseLeftButtonDown" MouseMove="ResizeGrip_MouseMove" MouseLeftButtonUp="ResizeGrip_MouseLeftButtonUp"/>
        <Rectangle Fill="Transparent" Width="6" HorizontalAlignment="Left" Cursor="SizeWE" Tag="W"
                   MouseLeftButtonDown="ResizeGrip_MouseLeftButtonDown" MouseMove="ResizeGrip_MouseMove" MouseLeftButtonUp="ResizeGrip_MouseLeftButtonUp"/>
        <Rectangle Fill="Transparent" Width="6" HorizontalAlignment="Right" Cursor="SizeWE" Tag="E"
                   MouseLeftButtonDown="ResizeGrip_MouseLeftButtonDown" MouseMove="ResizeGrip_MouseMove" MouseLeftButtonUp="ResizeGrip_MouseLeftButtonUp"/>
        <Rectangle Fill="Transparent" Width="10" Height="10" HorizontalAlignment="Left" VerticalAlignment="Top" Cursor="SizeNWSE" Tag="NW"
                   MouseLeftButtonDown="ResizeGrip_MouseLeftButtonDown" MouseMove="ResizeGrip_MouseMove" MouseLeftButtonUp="ResizeGrip_MouseLeftButtonUp"/>
        <Rectangle Fill="Transparent" Width="10" Height="10" HorizontalAlignment="Right" VerticalAlignment="Top" Cursor="SizeNESW" Tag="NE"
                   MouseLeftButtonDown="ResizeGrip_MouseLeftButtonDown" MouseMove="ResizeGrip_MouseMove" MouseLeftButtonUp="ResizeGrip_MouseLeftButtonUp"/>
        <Rectangle Fill="Transparent" Width="10" Height="10" HorizontalAlignment="Left" VerticalAlignment="Bottom" Cursor="SizeNESW" Tag="SW"
                   MouseLeftButtonDown="ResizeGrip_MouseLeftButtonDown" MouseMove="ResizeGrip_MouseMove" MouseLeftButtonUp="ResizeGrip_MouseLeftButtonUp"/>
        <Rectangle Fill="Transparent" Width="10" Height="10" HorizontalAlignment="Right" VerticalAlignment="Bottom" Cursor="SizeNWSE" Tag="SE"
                   MouseLeftButtonDown="ResizeGrip_MouseLeftButtonDown" MouseMove="ResizeGrip_MouseMove" MouseLeftButtonUp="ResizeGrip_MouseLeftButtonUp"/>
    </Grid>
</Window>
