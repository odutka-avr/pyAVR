                                            <ItemsControl Name="ViewPickerList">
                                                <ItemsControl.GroupStyle>
                                                    <GroupStyle>
                                                        <GroupStyle.HeaderTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="Bold"
                                                                           Foreground="{StaticResource AccentBrush}" Margin="0,8,0,4"/>
                                                            </DataTemplate>
                                                        </GroupStyle.HeaderTemplate>
                                                    </GroupStyle>
                                                </ItemsControl.GroupStyle>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <CheckBox Style="{StaticResource PickerCheckBoxStyle}"
                                                                  IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                                  Margin="0,4">
                                                            <StackPanel Orientation="Horizontal">
                                                                <Border Width="70" Height="18" CornerRadius="9" BorderThickness="0"
                                                                        Background="#80573F85" Margin="0,0,8,0">
                                                                    <TextBlock Text="{Binding ViewTypeLabel}" FontSize="9" FontWeight="Bold"
                                                                               Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Border>
                                                                <TextBlock Text="{Binding ViewName}" Foreground="White" FontSize="11"
                                                                           VerticalAlignment="Center" TextWrapping="NoWrap"/>
                                                            </StackPanel>
                                                        </CheckBox>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>

                                        <Button Name="ViewPickerAddButton" Content="Додати обрані" Width="140" Height="32"
                                                HorizontalAlignment="Right" Margin="0,12,0,0"
                                                FontWeight="Bold" BorderThickness="1.5" Click="ViewPickerAdd_Click">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Background" Value="{StaticResource ApplyButtonBgBrush}"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                    <Setter Property="BorderBrush" Value="Transparent"/>
                                                </Style>
                                            </Button.Style>
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                           TextElement.Foreground="{TemplateBinding Foreground}"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </Popup>
                            </StackPanel>
                        </DataTemplate>
                        </DataGrid.RowDetailsTemplate>

                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="" Width="20">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="+" Width="15" Height="22"
                                                Click="ButtonEvent_AddSheetAfterRow"
                                                Tag="{Binding}"
                                                FontWeight="Bold"
                                                FontSize="14"
                                                Foreground="{StaticResource TableBorderBrush}"
                                                Background="Transparent"
                                                BorderThickness="1"
                                                Cursor="Hand">
                                            <Button.ToolTip>
                                                <ToolTip Background="Transparent" BorderThickness="0" HasDropShadow="False" Placement="Bottom">
                                                    <Border Padding="10,6" CornerRadius="8" MaxWidth="220"
                                                            Background="{StaticResource TableBackgroundBrush}"
                                                            BorderBrush="{StaticResource AccentBrush}" BorderThickness="2">
                                                        <TextBlock Text="Додати новий лист після цього"
                                                                   Foreground="#878787" FontSize="11"/>
                                                    </Border>
                                                </ToolTip>
                                            </Button.ToolTip>
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" CornerRadius="4">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="{StaticResource AccentLightBrush}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Visibility" Value="Hidden"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=IsMouseOver}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="" Width="15">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Name="DragHandleIcon" Text="↕" FontSize="14" Foreground="{StaticResource TableBorderBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Cursor="Hand"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="" Width="30">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                    Cursor="Hand" MouseLeftButtonDown="ViewsExpander_Click">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasPlacedViews}" Value="False">
                                                            <Setter Property="Visibility" Value="Hidden"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>

                                            <Path Name="Arrow" Data="M 5,3 L 10,8 L 5,13"
                                                  Stroke="{StaticResource TableBorderBrush}"
                                                  StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                  Width="10" Height="10" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,1,0"
                                                  RenderTransformOrigin="0.5,0.5">
                                                <Path.Style>
                                                    <Style TargetType="Path">
                                                        <Setter Property="RenderTransform">
                                                            <Setter.Value>
                                                                <RotateTransform Angle="0"/>
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                                <Setter Property="RenderTransform">
                                                                    <Setter.Value>
                                                                        <RotateTransform Angle="90"/>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Path.Style>
                                            </Path>

                                            <Rectangle Width="2" Height="14" RadiusX="1" RadiusY="1"
                                                       Fill="{StaticResource TableBorderBrush}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="" Width="26">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <!-- Кружечок "С" - новий (запланований) лист -->
                                            <Border Width="16" Height="16" CornerRadius="8" BorderThickness="1.5"
                                                    Background="{StaticResource TableBackgroundBrush}"
                                                    BorderBrush="{StaticResource NewSheetTextBrush}">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsNew}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Border.ToolTip>
                                                    <ToolTip Background="Transparent" BorderThickness="0" HasDropShadow="False">
                                                        <Border Padding="10,6" CornerRadius="8" MaxWidth="220"
                                                                Background="{StaticResource TableBackgroundBrush}"
                                                                BorderBrush="{StaticResource NewSheetTextBrush}" BorderThickness="1">
                                                            <TextBlock Text="Новий лист"
                                                                       Foreground="#706F6F" FontSize="11" TextWrapping="Wrap"/>
                                                        </Border>
                                                    </ToolTip>
                                                </Border.ToolTip>
                                                <TextBlock Text="Н" FontSize="10" FontWeight="Bold"
                                                           Foreground="{StaticResource NewSheetTextBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>

                                            <!-- Кружечок "i" - є зміни, все гаразд -->
                                            <Border Width="16" Height="16" CornerRadius="8" BorderThickness="1.5"
                                                    Background="{StaticResource TableBackgroundBrush}"
                                                    BorderBrush="{StaticResource AccentBrush}">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasChanges}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsDuplicateNumber}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsNew}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding ViewsHaveChanges}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Border.ToolTip>
                                                    <ToolTip Background="Transparent" BorderThickness="0" HasDropShadow="False" Placement="Top" VerticalOffset="0">
                                                        <Border Padding="10,6" CornerRadius="8" MaxWidth="220"
                                                                Background="{StaticResource TableBackgroundBrush}"
                                                                BorderBrush="{StaticResource AccentBrush}" BorderThickness="1">
                                                            <TextBlock Text="{Binding ChangedFieldsText}"
                                                                       Foreground="{StaticResource NeutralTextBrush}" FontSize="11" TextWrapping="Wrap"/>
                                                        </Border>
                                                    </ToolTip>
                                                </Border.ToolTip>
                                                <TextBlock Text="i" FontSize="10" FontWeight="Bold"
                                                           Foreground="{StaticResource AccentBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>

                                            <!-- Кружечок "В" - зміни в розміщених видах -->
                                            <Border Width="16" Height="16" CornerRadius="8" BorderThickness="1.5"
                                                    Background="{StaticResource TableBackgroundBrush}"
                                                    BorderBrush="{StaticResource ViewsChangedTextBrush}">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ViewsHaveChanges}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsDuplicateNumber}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsNew}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Border.ToolTip>
                                                    <ToolTip Background="Transparent" BorderThickness="0" HasDropShadow="False" Placement="Bottom">
                                                        <Border Padding="10,6" CornerRadius="8" MaxWidth="220"
                                                                Background="{StaticResource TableBackgroundBrush}"
                                                                BorderBrush="{StaticResource ViewsChangedTextBrush}" BorderThickness="2">
                                                            <TextBlock Text="{Binding ChangedFieldsText}"
                                                                       Foreground="#878787" FontSize="11" TextWrapping="Wrap"/>
                                                        </Border>
                                                    </ToolTip>
                                                </Border.ToolTip>
                                                <TextBlock Text="В" FontSize="10" FontWeight="Bold"
                                                           Foreground="{StaticResource ViewsChangedTextBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>

                                            <!-- Кружечок "!" - дублікат номера, помилка -->
                                            <Border Width="16" Height="16" CornerRadius="8" BorderThickness="1.5"
                                                    Background="{StaticResource TableBackgroundBrush}"
                                                    BorderBrush="{StaticResource ErrorTextBrush}">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsDuplicateNumber}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Border.ToolTip>
                                                    <ToolTip Background="Transparent" BorderThickness="0" HasDropShadow="False" Placement="Top" VerticalOffset="0">
                                                        <Border Padding="10,6" CornerRadius="8" MaxWidth="220"
                                                                Background="{StaticResource TableBackgroundBrush}"
                                                                BorderBrush="{StaticResource ErrorTextBrush}" BorderThickness="1">
                                                            <TextBlock Text="Дублікат номера листа! Виправте номер."
                                                                       Foreground="{StaticResource NeutralTextBrush}" FontSize="11" TextWrapping="Wrap"/>
                                                        </Border>
                                                    </ToolTip>
                                                </Border.ToolTip>
                                                <TextBlock Text="!" FontSize="10" FontWeight="Bold"
                                                           Foreground="{StaticResource ErrorTextBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>

                                            <!-- Кружечок нейтральний - без змін, без помилок -->
                                            <Border Width="16" Height="16" CornerRadius="8" BorderThickness="1.5"
                                                    Background="{StaticResource TableBackgroundBrush}"
                                                    BorderBrush="{StaticResource NeutralTextBrush}">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasChanges}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsDuplicateNumber}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding ViewsHaveChanges}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Border.ToolTip>
                                                    <ToolTip Background="Transparent" BorderThickness="0" HasDropShadow="False"
                                                             Placement="Top" VerticalOffset="0">
                                                        <Border Padding="10,6" CornerRadius="8" MaxWidth="220"
                                                                Background="{StaticResource TableBackgroundBrush}"
                                                                BorderBrush="{StaticResource NeutralTextBrush}" BorderThickness="1">
                                                            <TextBlock Text="Немає змін" Foreground="{StaticResource NeutralTextBrush}" FontSize="11"/>
                                                        </Border>
                                                    </ToolTip>
                                                </Border.ToolTip>
                                                <TextBlock Text="" FontSize="10" FontWeight="Bold"
                                                           Foreground="{StaticResource NeutralTextBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>

                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="НОМЕР" Binding="{Binding Number}" Width="80" >
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Padding" Value="8,0,0,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                                <DataGridTextColumn.EditingElementStyle>
                                    <Style TargetType="TextBox">
                                        <Setter Property="Background" Value="#30302F"/>
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Padding" Value="8,0,12,0"/>
                                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.EditingElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="НАЗВА" Binding="{Binding Name}" Width="350">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Padding" Value="8,0,0,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                                <DataGridTextColumn.EditingElementStyle>
                                    <Style TargetType="TextBox">
                                        <Setter Property="Background" Value="#30302F"/>
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Padding" Value="8,0,12,0"/>
                                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.EditingElementStyle>
                            </DataGridTextColumn>

                            <DataGridTemplateColumn Header="TITLEBLOCK" Width="350" >
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding TitleBlockOptions}"
                                                  SelectedItem="{Binding TitleBlock, Mode=TwoWay}"
                                                  SelectionChanged="ComboBox_TitleBlockChanged"
                                                  DropDownOpened="ComboBox_TitleBlockDropDownOpened"
                                                  BorderThickness="0"
                                                  Background="Transparent"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Name="SkeletonOverlay" Margin="10" Visibility="Collapsed">
                        <StackPanel.Resources>
                            <Style x:Key="SkeletonBar" TargetType="Border">
                                <Setter Property="Background" Value="{StaticResource RowPillBrush}"/>
                                <Setter Property="CornerRadius" Value="6"/>
                                <Setter Property="Height" Value="34"/>
                                <Setter Property="Margin" Value="0,3"/>
                            </Style>
                        </StackPanel.Resources>
                        <Border Style="{StaticResource SkeletonBar}"/>
                        <Border Style="{StaticResource SkeletonBar}"/>
                        <Border Style="{StaticResource SkeletonBar}"/>
                        <Border Style="{StaticResource SkeletonBar}"/>
                        <Border Style="{StaticResource SkeletonBar}"/>
                        <Border Style="{StaticResource SkeletonBar}"/>
                        <Border Style="{StaticResource SkeletonBar}"/>
                        <Border Style="{StaticResource SkeletonBar}"/>
                    </StackPanel>

                    <Grid Name="EmptyFilterOverlay" Visibility="Collapsed">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="Оберіть групу з фільтру" FontSize="13"
                                       Foreground="{StaticResource AddButtonTextBrush}"
                                       HorizontalAlignment="Center" Margin="0,0,0,10"/>
                            <Button Name="btn_CreateNewStage" Content="Створити нову стадію"
                                    Width="160" Height="30" Margin="0,4,10,0"
                                    HorizontalAlignment="Center" Padding="14,8"
                                    FontWeight="Bold" BorderThickness="1.5"
                                    Click="ButtonEvent_AddSheet">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="{StaticResource AddButtonBgBrush}"/>
                                        <Setter Property="Foreground" Value="{StaticResource AddButtonTextBrush}"/>
                                        <Setter Property="BorderBrush" Value="Transparent"/>
                                    </Style>
                                </Button.Style>
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Name="BtnBorder" Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="8">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               TextElement.Foreground="{TemplateBinding Foreground}"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="BtnBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </Grid>
                    </Grid>
                </Border>
                    <Button Name="btn_GroupFilter" Width="30" Height="30" Margin="6,6,0,0"
                            HorizontalAlignment="Left" VerticalAlignment="Top"
                            Click="GroupFilterButton_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="{StaticResource AddButtonTextBrush}"/>
                                <Setter Property="BorderBrush" Value="Transparent"/>
                            </Style>
                        </Button.Style>
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Name="BtnBorder" Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1.5"
                                        CornerRadius="8">
                                    <Path Data="M 4,4 L 16,4 L 11,10 L 11,15 L 9,15 L 9,10 Z"
                                          Fill="{TemplateBinding Foreground}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Width="14" Height="14" Stretch="Uniform"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="BtnBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Popup Name="GroupFilterPopup" PlacementTarget="{Binding ElementName=btn_GroupFilter}"
                           Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
                        <Border Background="{StaticResource TableBackgroundBrush}"
                                BorderBrush="{StaticResource TableBorderBrush}" BorderThickness="1"
                                CornerRadius="10" Padding="12" MaxWidth="300">
                            <StackPanel>
                                <TextBlock Text="Фільтр за розділами" FontSize="12" FontWeight="Bold"
                                           Foreground="{StaticResource AccentBrush}" Margin="0,0,0,10"/>

                                <ItemsControl Name="ic_GroupFilterList">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <ToggleButton Content="{Binding GroupName}"
                                                          IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                          Checked="GroupFilterChip_Changed"
                                                          Unchecked="GroupFilterChip_Changed"
                                                          Margin="0,0,6,6" Padding="12,5"
                                                          FontFamily="{StaticResource AppFont}" FontSize="11">
                                                <ToggleButton.Style>
                                                    <Style TargetType="ToggleButton">
                                                        <Setter Property="Foreground" Value="{StaticResource HeaderTextBrush}"/>
                                                    </Style>
                                                </ToggleButton.Style>
                                                <ToggleButton.Template>
                                                    <ControlTemplate TargetType="ToggleButton">
                                                        <Border Name="ChipBorder" CornerRadius="12"
                                                                Background="Transparent"
                                                                BorderBrush="{StaticResource TableBorderBrush}" BorderThickness="1"
                                                                Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                               TextElement.Foreground="{TemplateBinding Foreground}"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsChecked" Value="True">
                                                                <Setter TargetName="ChipBorder" Property="Background" Value="#406D5DFB"/>
                                                                <Setter TargetName="ChipBorder" Property="BorderBrush" Value="Transparent"/>
                                                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                                            </Trigger>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="ChipBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </ToggleButton.Template>
                                            </ToggleButton>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </Popup>
                    </Grid>


                    <StackPanel Grid.Column="0" Margin="10,0,0,0">
                        <Button  Name="btn_RenameSelected" Content="Змінити назву"
                            Width="120" Height="30" Margin="0,4,10,0"
                            FontWeight="Bold"
                            BorderThickness="1.5"
                            ToolTipService.ShowOnDisabled="True"
                            Click="ButtonEvent_RenameSelected">
                        <Button.ToolTip>
                            <ToolTip Background="Transparent" BorderThickness="0" HasDropShadow="False" Placement="Bottom">
                                <Border Padding="10,6" CornerRadius="8" Width="220"
                                        Background="{StaticResource TableBackgroundBrush}"
                                        BorderBrush="{StaticResource AccentBrush}" BorderThickness="2">
                                    <TextBlock Text="Виділіть листи (Ctrl+клік) і задайте префікс/суфікс чи заміну частини назви - з живим прев'ю."
                                               Foreground="#878787" FontSize="11" TextWrapping="Wrap"/>
                                </Border>
                            </ToolTip>
                        </Button.ToolTip>
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="{StaticResource AddButtonBgBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource AddButtonTextBrush}"/>
                                <Setter Property="BorderBrush" Value="Transparent"/>
                                <Style.Triggers>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Background" Value="{StaticResource TableBackgroundBrush}"/>
                                        <Setter Property="Foreground" Value="#3A3A3D"/>
                                        <Setter Property="BorderBrush" Value="Transparent"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Name="BtnBorder" Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="8">
                                    <ContentPresenter Name="BtnContent" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       TextElement.Foreground="{TemplateBinding Foreground}"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <MultiTrigger>
                                        <MultiTrigger.Conditions>
                                            <Condition Property="IsMouseOver" Value="True"/>
                                            <Condition Property="IsEnabled" Value="True"/>
                                        </MultiTrigger.Conditions>
                                        <Setter TargetName="BtnBorder" Property="Background" Value="#090A0A"/>
                                        <Setter TargetName="BtnBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                        <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                    </MultiTrigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Button  Name="btn_RenumberSelected" Content="Змінити номер"
                            Width="120" Height="30" Margin="0,4,10,0"
                            FontWeight="Bold"
                            BorderThickness="1.5"
                            ToolTipService.ShowOnDisabled="True"
                            Click="ButtonEvent_RenumberSelected">
                        <Button.ToolTip>
                            <ToolTip Background="Transparent" BorderThickness="0" HasDropShadow="False" Placement="Bottom">
                                <Border Padding="10,6" CornerRadius="8" Width="220"
                                        Background="{StaticResource TableBackgroundBrush}"
                                        BorderBrush="{StaticResource AccentBrush}" BorderThickness="2">
                                    <TextBlock Text="Виділіть кілька листів у таблиці (Ctrl+клік) і задайте новий початковий номер - решта перенумеруються підряд."
                                               Foreground="#878787" FontSize="11" TextWrapping="Wrap"/>
                                </Border>
                            </ToolTip>
                        </Button.ToolTip>
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="{StaticResource AddButtonBgBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource AddButtonTextBrush}"/>
                                <Setter Property="BorderBrush" Value="Transparent"/>
                                <Style.Triggers>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Background" Value="{StaticResource TableBackgroundBrush}"/>
                                        <Setter Property="Foreground" Value="#3A3A3D"/>
                                        <Setter Property="BorderBrush" Value="Transparent"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Name="BtnBorder" Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="8">
                                    <ContentPresenter Name="BtnContent" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       TextElement.Foreground="{TemplateBinding Foreground}"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <MultiTrigger>
                                        <MultiTrigger.Conditions>
                                            <Condition Property="IsMouseOver" Value="True"/>
                                            <Condition Property="IsEnabled" Value="True"/>
                                        </MultiTrigger.Conditions>
                                        <Setter TargetName="BtnBorder" Property="Background" Value="#090A0A"/>
                                        <Setter TargetName="BtnBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                        <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                    </MultiTrigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Button  Name="btn_AddSheet" Content="Додати лист"
                            Width="120" Height="30" Margin="0,4,10,0"
                            FontWeight="Bold"
                            BorderThickness="1.5"
                            Click="ButtonEvent_AddSheet">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="{StaticResource AddButtonBgBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource AddButtonTextBrush}"/>
                                <Setter Property="BorderBrush" Value="Transparent"/>
                            </Style>
                        </Button.Style>
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Name="BtnBorder" Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="8">
                                    <ContentPresenter Name="BtnContent" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       TextElement.Foreground="{TemplateBinding Foreground}"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="BtnBorder" Property="Background" Value="#090A0A"/>
                                        <Setter TargetName="BtnBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                        <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Button  Name="btn_CreateViewsFromLevels" Content="Створити види"
                            Width="120" Height="30" Margin="0,4,10,0"
                            FontWeight="Bold"
                            BorderThickness="1.5"
                            Click="ButtonEvent_OpenCreateViews">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="{StaticResource AddButtonBgBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource AddButtonTextBrush}"/>
                                <Setter Property="BorderBrush" Value="Transparent"/>
                            </Style>
                        </Button.Style>
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Name="BtnBorder" Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="8">
                                    <ContentPresenter Name="BtnContent" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       TextElement.Foreground="{TemplateBinding Foreground}"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="BtnBorder" Property="Background" Value="#090A0A"/>
                                        <Setter TargetName="BtnBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                        <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    </StackPanel>
                </Grid>

                <!-- ═══════ ПАНЕЛЬ КНОПОК ═══════ -->
                <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                    <Button Name="btn_DiscardChanges" Content="Прибрати зміни"
                        Width="140" Height="34"
                        FontWeight="Bold"
                        BorderThickness="1"
                        Margin="0,0,10,0"
                        Click="ButtonEvent_DiscardChanges">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="{StaticResource TableBackgroundBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource HeaderTextBrush}"/>
                            <Setter Property="BorderBrush" Value="{StaticResource TableBorderBrush}"/>
                        </Style>
                    </Button.Style>
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Name="BtnBorder" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8">
                                <ContentPresenter Name="BtnContent" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   TextElement.Foreground="{TemplateBinding Foreground}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="BtnBorder" Property="BorderBrush" Value="{StaticResource ErrorTextBrush}"/>
                                    <Setter Property="Foreground" Value="{StaticResource ErrorTextBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                    <Button Name="btn_SaveToRevit" Width="160" Height="34"
                            BorderThickness="1.5"
                            Click="ButtonEvent_ApplyAll">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="{StaticResource ApplyButtonBgBrush}"/>
                                <Setter Property="Foreground" Value="#F9F9F9"/>
                                <Setter Property="BorderBrush" Value="Transparent"/>
                                <Style.Triggers>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Background" Value="{StaticResource TableBackgroundBrush}"/>
                                        <Setter Property="Foreground" Value="{StaticResource NeutralTextBrush}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Name="BtnBorder" Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="8" ClipToBounds="True">
                                    <ContentPresenter/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#F9F9F9"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>

                        <Grid ClipToBounds="True">
                            <Grid.Clip>
                                <RectangleGeometry Rect="0,0,160,34" RadiusX="8" RadiusY="8"/>
                            </Grid.Clip>
                            <Border Name="ApplyProgressFill" Background="#33FFFFFF"
                                    HorizontalAlignment="Left" Width="0"/>
                            <TextBlock Name="ApplyButtonLabel" Text="Застосувати"
                                       FontWeight="Bold" Foreground="#F9F9F9" FontFamily="{StaticResource AppFont}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock Name="ApplyButtonCheckmark" Text="✓"
                                       FontWeight="Bold" FontSize="16" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="Collapsed" Opacity="0">
                                <TextBlock.RenderTransform>
                                    <TranslateTransform Y="10"/>
                                </TextBlock.RenderTransform>
                            </TextBlock>
                        </Grid>
                    </Button>
                </StackPanel>

            </Grid>
        </Border>

        <!-- ═══════ РУЧКИ ЗМІНИ РОЗМІРУ ═══════ -->
        <Rectangle Fill="Transparent" Height="6" VerticalAlignment="Top"
                   Cursor="SizeNS" Tag="N"
                   MouseLeftButtonDown="ResizeGrip_MouseLeftButtonDown"
                   MouseMove="ResizeGrip_MouseMove"
                   MouseLeftButtonUp="ResizeGrip_MouseLeftButtonUp"/>
        <Rectangle Fill="Transparent" Height="6" VerticalAlignment="Bottom"
                   Cursor="SizeNS" Tag="S"
                   MouseLeftButtonDown="ResizeGrip_MouseLeftButtonDown"
                   MouseMove="ResizeGrip_MouseMove"
                   MouseLeftButtonUp="ResizeGrip_MouseLeftButtonUp"/>
        <Rectangle Fill="Transparent" Width="6" HorizontalAlignment="Left"
                   Cursor="SizeWE" Tag="W"
                   MouseLeftButtonDown="ResizeGrip_MouseLeftButtonDown"
                   MouseMove="ResizeGrip_MouseMove"
                   MouseLeftButtonUp="ResizeGrip_MouseLeftButtonUp"/>
        <Rectangle Fill="Transparent" Width="6" HorizontalAlignment="Right"
                   Cursor="SizeWE" Tag="E"
                   MouseLeftButtonDown="ResizeGrip_MouseLeftButtonDown"
                   MouseMove="ResizeGrip_MouseMove"
                   MouseLeftButtonUp="ResizeGrip_MouseLeftButtonUp"/>

        <Rectangle Fill="Transparent" Width="10" Height="10"
                   HorizontalAlignment="Left" VerticalAlignment="Top"
                   Cursor="SizeNWSE" Tag="NW"
                   MouseLeftButtonDown="ResizeGrip_MouseLeftButtonDown"
                   MouseMove="ResizeGrip_MouseMove"
                   MouseLeftButtonUp="ResizeGrip_MouseLeftButtonUp"/>
        <Rectangle Fill="Transparent" Width="10" Height="10"
                   HorizontalAlignment="Right" VerticalAlignment="Top"
                   Cursor="SizeNESW" Tag="NE"
                   MouseLeftButtonDown="ResizeGrip_MouseLeftButtonDown"
                   MouseMove="ResizeGrip_MouseMove"
                   MouseLeftButtonUp="ResizeGrip_MouseLeftButtonUp"/>
        <Rectangle Fill="Transparent" Width="10" Height="10"
                   HorizontalAlignment="Left" VerticalAlignment="Bottom"
                   Cursor="SizeNESW" Tag="SW"
                   MouseLeftButtonDown="ResizeGrip_MouseLeftButtonDown"
                   MouseMove="ResizeGrip_MouseMove"
                   MouseLeftButtonUp="ResizeGrip_MouseLeftButtonUp"/>
        <Rectangle Fill="Transparent" Width="10" Height="10"
                   HorizontalAlignment="Right" VerticalAlignment="Bottom"
                   Cursor="SizeNWSE" Tag="SE"
                   MouseLeftButtonDown="ResizeGrip_MouseLeftButtonDown"
                   MouseMove="ResizeGrip_MouseMove"
                   MouseLeftButtonUp="ResizeGrip_MouseLeftButtonUp"/>

    </Grid>
</Window>
