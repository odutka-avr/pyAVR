<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Листи проєкту" Height="800" Width="1080"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="Manual"
        ResizeMode="NoResize"
        PreviewKeyDown="MainWindow_PreviewKeyDown">

    <Window.Resources>
        <!-- ═══════ ШРИФТ ═══════ -->
        <FontFamily x:Key="AppFont">Tahoma</FontFamily>

        <!-- ═══════ КОЛЬОРОВА ПАЛІТРА ═══════ -->
        <SolidColorBrush x:Key="AccentBrush"           Color="#6D5DFB"/>
        <SolidColorBrush x:Key="AccentLightBrush"      Color="#F1EFFF"/>
        <SolidColorBrush x:Key="AccentSelectedBrush"   Color="#F1EFFF"/>
        <SolidColorBrush x:Key="GroupHeaderBrush"      Color="#181818"/>
        <SolidColorBrush x:Key="RowHoverBrush"         Color="#F8F8FA"/>
        <SolidColorBrush x:Key="TextPrimaryBrush"      Color="#202124"/>
        <SolidColorBrush x:Key="TextSecondaryBrush"    Color="#7A7F87"/>
        <SolidColorBrush x:Key="BorderColorBrush"      Color="#E7E8EB"/>
        <SolidColorBrush x:Key="SurfaceBrush"          Color="#FFFFFF"/>
        <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#090A0A"/>
        <SolidColorBrush x:Key="TableBackgroundBrush"  Color="#181818"/>
        <SolidColorBrush x:Key="TableBorderBrush"      Color="#55555A"/>
        <SolidColorBrush x:Key="RowPillBrush"          Color="#262626"/>
        <SolidColorBrush x:Key="HeaderTextBrush"       Color="#55555A"/>
        <SolidColorBrush x:Key="ScrollBarBrush"        Color="#55555A"/>
        <SolidColorBrush x:Key="AddButtonBgBrush"      Color="#1D152C"/>
        <SolidColorBrush x:Key="AddButtonTextBrush"    Color="#573F85"/>
        <SolidColorBrush x:Key="ApplyButtonBgBrush"    Color="#573F85"/>
        <SolidColorBrush x:Key="EditBackgroundBrush"   Color="#7160A7"/>
        <SolidColorBrush x:Key="ErrorTextBrush"        Color="#E52320"/>
        <SolidColorBrush x:Key="ErrorRowBrush"         Color="#160606"/>
        <SolidColorBrush x:Key="NeutralTextBrush"      Color="#878787"/>
        <SolidColorBrush x:Key="NewSheetTextBrush"     Color="#52A0D8"/>
        <SolidColorBrush x:Key="NewRowBgBrush"         Color="#132034"/>
        <SolidColorBrush x:Key="ChangedRowBgBrush"     Color="#1D152C"/>
        <SolidColorBrush x:Key="ViewsChangedTextBrush" Color="#E8A33D"/>

        <!-- ═══════ НЕЯВНІ СТИЛІ ═══════ -->
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
            <Setter Property="RowHeaderWidth" Value="0"/>
        </Style>

        <!-- ═══════ ЗАГОЛОВКИ КОЛОНОК  ═══════ -->
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource HeaderTextBrush}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridColumnHeader">
                        <Border Background="{TemplateBinding Background}" BorderThickness="0">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                               VerticalAlignment="Center" HorizontalAlignment="Left"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══════ СПАДАЛКА ГРУПИ ═══════ -->
        <Style x:Key="GroupExpanderStyle" TargetType="Expander">
            <Setter Property="Background" Value="{StaticResource TableBackgroundBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <Border Name="MainBorder" Background="{TemplateBinding Background}"
                                BorderBrush="Transparent" BorderThickness="0" CornerRadius="6">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <ToggleButton Grid.Row="0" Padding="4"
                                              IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Grid Background="Transparent">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,10,0" VerticalAlignment="Center">
                                                    <Rectangle Width="2" Height="14" RadiusX="1" RadiusY="1"
                                                               Fill="{StaticResource TableBorderBrush}" Margin="0,0,8,0"/>
                                                    <Path Name="Arrow" Data="M 5,3 L 10,8 L 5,13"
                                                          Stroke="{StaticResource TableBorderBrush}"
                                                          StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                          Width="10" Height="10" Stretch="Uniform" VerticalAlignment="Center"/>
                                                </StackPanel>

                                                <ContentPresenter Grid.Column="1" ContentSource="Content"
                                                                   VerticalAlignment="Center"/>
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="Arrow" Property="Data" Value="M 3,5 L 8,10 L 13,5"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                    <ContentPresenter ContentSource="Header"/>
                                </ToggleButton>

                                <ContentPresenter Grid.Row="1" Name="ExpandSite" Visibility="Collapsed"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══════ COMBOBOX ═══════ -->
        <Style TargetType="ComboBox">
            <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Name="ToggleBtn"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Name="MainBorder"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="4">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="20"/>
                                                </Grid.ColumnDefinitions>
                                                <Path Name="Arrow" Grid.Column="1"
                                                      Data="M 4,6 L 8,10 L 12,6"
                                                      Stroke="{StaticResource TableBorderBrush}"
                                                      StrokeThickness="1.5" StrokeLineJoin="Round"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="MainBorder" Property="BorderBrush" Value="{StaticResource TableBorderBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <ContentPresenter Name="ContentSite"
                                               IsHitTestVisible="False"
                                               Content="{TemplateBinding SelectionBoxItem}"
                                               ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                               Margin="8,0,24,0"
                                               VerticalAlignment="Center" HorizontalAlignment="Left"/>

                            <Popup Name="Popup" Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Border Background="{StaticResource TableBackgroundBrush}"
                                        BorderBrush="{StaticResource TableBorderBrush}"
                                        BorderThickness="1" CornerRadius="4"
                                        MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="200">
                                    <ScrollViewer>
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

            <Style.Triggers>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=IsSelected}" Value="True">
                    <Setter Property="Foreground" Value="White"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsDuplicateNumber}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource ErrorTextBrush}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource ErrorTextBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border Name="ItemBorder" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource TableBorderBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PickerCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Name="CheckBoxBorder" Width="16" Height="16" CornerRadius="4"
                                    Background="Transparent"
                                    BorderBrush="{StaticResource TableBorderBrush}" BorderThickness="1.5"
                                    VerticalAlignment="Center">
                                <Path Name="CheckMark" Data="M 3,7 L 6,10 L 12,3"
                                      Stroke="White" StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckBoxBorder" Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="CheckBoxBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══════ ВИНОСКА-ПІДКАЗКА: ІНФО (фіолетова) ═══════ -->
        <Style x:Key="InfoTooltipStyle" TargetType="ToolTip">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HasDropShadow" Value="False"/>
        </Style>

        <Style x:Key="ErrorTooltipStyle" TargetType="ToolTip">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HasDropShadow" Value="False"/>
        </Style>

        <!-- ═══════ ВЕРТИКАЛЬНИЙ СКРОЛБАР ═══════ -->
        <ControlTemplate x:Key="VerticalScrollBarTemplate" TargetType="ScrollBar">
            <Grid Width="14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <RepeatButton Grid.Row="0" Height="14" Command="ScrollBar.LineUpCommand" Background="Transparent" BorderThickness="0">
                    <RepeatButton.Template>
                        <ControlTemplate TargetType="RepeatButton">
                            <Path Data="M 4,9 L 7,4 L 10,9 Z" Width="8" Height="6" Stretch="Uniform"
                                  Fill="{StaticResource ScrollBarBrush}" Stroke="{StaticResource ScrollBarBrush}"
                                  StrokeThickness="2" StrokeLineJoin="Round"/>
                        </ControlTemplate>
                    </RepeatButton.Template>
                </RepeatButton>

                <Track Grid.Row="1" Name="PART_Track" IsDirectionReversed="True">
                    <Track.DecreaseRepeatButton>
                        <RepeatButton Command="ScrollBar.PageUpCommand" Background="Transparent" BorderThickness="0"/>
                    </Track.DecreaseRepeatButton>
                    <Track.IncreaseRepeatButton>
                        <RepeatButton Command="ScrollBar.PageDownCommand" Background="Transparent" BorderThickness="0"/>
                    </Track.IncreaseRepeatButton>
                    <Track.Thumb>
                        <Thumb>
                            <Thumb.Template>
                                <ControlTemplate TargetType="Thumb">
                                    <Border Background="{StaticResource ScrollBarBrush}" CornerRadius="7" Width="8" Margin="3,0"/>
                                </ControlTemplate>
                            </Thumb.Template>
                        </Thumb>
                    </Track.Thumb>
                </Track>

                <RepeatButton Grid.Row="2" Height="14" Command="ScrollBar.LineDownCommand" Background="Transparent" BorderThickness="0">
                    <RepeatButton.Template>
                        <ControlTemplate TargetType="RepeatButton">
                            <Path Data="M 4,4 L 10,4 L 7,9 Z" Width="8" Height="6" Stretch="Uniform"
                                  Fill="{StaticResource ScrollBarBrush}" Stroke="{StaticResource ScrollBarBrush}"
                                  StrokeThickness="2" StrokeLineJoin="Round"/>
                        </ControlTemplate>
                    </RepeatButton.Template>
                </RepeatButton>
            </Grid>
        </ControlTemplate>

        <!-- ═══════ ГОРИЗОНТАЛЬНИЙ СКРОЛБАР ═══════ -->
        <ControlTemplate x:Key="HorizontalScrollBarTemplate" TargetType="ScrollBar">
            <Grid Height="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <RepeatButton Grid.Column="0" Width="14" Command="ScrollBar.LineLeftCommand" Background="Transparent" BorderThickness="0">
                    <RepeatButton.Template>
                        <ControlTemplate TargetType="RepeatButton">
                            <Path Data="M 9,4 L 4,7 L 9,10 Z" Width="6" Height="8" Stretch="Uniform"
                                  Fill="{StaticResource ScrollBarBrush}" Stroke="{StaticResource ScrollBarBrush}"
                                  StrokeThickness="2" StrokeLineJoin="Round"/>
                        </ControlTemplate>
                    </RepeatButton.Template>
                </RepeatButton>

                <Track Grid.Column="1" Name="PART_Track">
                    <Track.DecreaseRepeatButton>
                        <RepeatButton Command="ScrollBar.PageLeftCommand" Background="Transparent" BorderThickness="0"/>
                    </Track.DecreaseRepeatButton>
                    <Track.IncreaseRepeatButton>
                        <RepeatButton Command="ScrollBar.PageRightCommand" Background="Transparent" BorderThickness="0"/>
                    </Track.IncreaseRepeatButton>
                    <Track.Thumb>
                        <Thumb>
                            <Thumb.Template>
                                <ControlTemplate TargetType="Thumb">
                                    <Border Background="{StaticResource ScrollBarBrush}" CornerRadius="7" Height="8" Margin="0,3"/>
                                </ControlTemplate>
                            </Thumb.Template>
                        </Thumb>
                    </Track.Thumb>
                </Track>

                <RepeatButton Grid.Column="2" Width="14" Command="ScrollBar.LineRightCommand" Background="Transparent" BorderThickness="0">
                    <RepeatButton.Template>
                        <ControlTemplate TargetType="RepeatButton">
                            <Path Data="M 4,4 L 9,7 L 4,10 Z" Width="6" Height="8" Stretch="Uniform"
                                  Fill="{StaticResource ScrollBarBrush}" Stroke="{StaticResource ScrollBarBrush}"
                                  StrokeThickness="2" StrokeLineJoin="Round"/>
                        </ControlTemplate>
                    </RepeatButton.Template>
                </RepeatButton>
            </Grid>
        </ControlTemplate>

        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template" Value="{StaticResource VerticalScrollBarTemplate}"/>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Template" Value="{StaticResource HorizontalScrollBarTemplate}"/>
                    <Setter Property="Height" Value="14"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>

        <Border Name="RootBorder" CornerRadius="14" Background="{StaticResource WindowBackgroundBrush}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="BorderBrush" Value="Transparent"/>
                    <Setter Property="BorderThickness" Value="2"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=IsActive}" Value="True">
                            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <Grid Name="MainContentGrid" Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ═══════ ВЛАСНИЙ ЗАГОЛОВОК ═══════ -->
                <Grid Grid.Row="0" Background="#090A0A"
                      MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Image Grid.Column="0" Name="img_TitleIcon" Width="20" Height="20"
                        Margin="16,0,0,0" VerticalAlignment="Center"/>

                    <TextBlock Grid.Column="0" Grid.ColumnSpan="3" Text="Листи+"
                               FontSize="14" FontWeight="SemiBold" Foreground="#55555A"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,8,0">
                        <Button Content="—" Width="34" Height="30"
                                Background="Transparent" BorderThickness="0" Foreground="{StaticResource TableBorderBrush}"
                                Click="TitleBar_Minimize" FontWeight="Bold">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Name="BtnBorder" Background="{TemplateBinding Background}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="BtnBorder" Property="Background" Value="{StaticResource RowPillBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Content="✕" Width="34" Height="30"
                                Background="Transparent" BorderThickness="0" Foreground="{StaticResource TableBorderBrush}"
                                Click="TitleBar_Close" FontWeight="Bold">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Name="BtnBorder" Background="{TemplateBinding Background}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="BtnBorder" Property="Background" Value="{StaticResource RowPillBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- ═══════ КАРТКА СТАТУСУ ═══════ -->
                <Border Grid.Row="2" Background="{StaticResource TableBackgroundBrush}"
                        BorderBrush="{StaticResource TableBorderBrush}" BorderThickness="1"
                        CornerRadius="10" Margin="16,16,0,10" Padding="14">
                    <StackPanel>
                        <TextBlock Text="КАРТА ЗМІН" FontSize="12" FontWeight="Bold"
                                   Foreground="{StaticResource HeaderTextBrush}" Margin="0,0,0,10"/>

                        <UniformGrid Rows="1" Columns="6">
                            <Border Background="{StaticResource RowPillBrush}" CornerRadius="8" Margin="0,0,6,0" Padding="8,8">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Name="tb_StatNewSheets" Text="0" FontSize="18" FontWeight="Bold"
                                               Foreground="#52A0D8" HorizontalAlignment="Center"/>
                                    <TextBlock Text="НОВІ ЛИСТИ" FontSize="8" Foreground="{StaticResource HeaderTextBrush}"
                                               HorizontalAlignment="Center" Margin="0,4,0,0" TextAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <Border Background="{StaticResource RowPillBrush}" CornerRadius="8" Margin="0,0,6,0" Padding="8,8">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Name="tb_StatNewViews" Text="0" FontSize="18" FontWeight="Bold"
                                               Foreground="#52A0D8" HorizontalAlignment="Center"/>
                                    <TextBlock Text="НОВІ ВИДИ" FontSize="8" Foreground="{StaticResource HeaderTextBrush}"
                                               HorizontalAlignment="Center" Margin="0,4,0,0" TextAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <Border Background="{StaticResource RowPillBrush}" CornerRadius="8" Margin="0,0,6,0" Padding="8,8">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Name="tb_StatChangedSheets" Text="0" FontSize="18" FontWeight="Bold"
                                               Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="ЗМІНИ В ЛИСТАХ" FontSize="8" Foreground="{StaticResource HeaderTextBrush}"
                                               HorizontalAlignment="Center" Margin="0,4,0,0" TextAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <Border Background="{StaticResource RowPillBrush}" CornerRadius="8" Margin="0,0,6,0" Padding="8,8">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Name="tb_StatChangedViews" Text="0" FontSize="18" FontWeight="Bold"
                                               Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="ЗМІНИ В ВИДАХ" FontSize="8" Foreground="{StaticResource HeaderTextBrush}"
                                               HorizontalAlignment="Center" Margin="0,4,0,0" TextAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <Border Background="{StaticResource RowPillBrush}" CornerRadius="8" Margin="0,0,6,0" Padding="8,8">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Name="tb_StatRemoved" Text="0" FontSize="18" FontWeight="Bold"
                                               Foreground="#E52320" HorizontalAlignment="Center"/>
                                    <TextBlock Text="ВИДАЛЕНО" FontSize="8" Foreground="{StaticResource HeaderTextBrush}"
                                               HorizontalAlignment="Center" Margin="0,4,0,0" TextAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <Border Background="{StaticResource RowPillBrush}" CornerRadius="8" Padding="8,8">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Name="tb_StatErrors" Text="0" FontSize="18" FontWeight="Bold"
                                               Foreground="{StaticResource ErrorTextBrush}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="ПОМИЛОК" FontSize="8" Foreground="{StaticResource HeaderTextBrush}"
                                               HorizontalAlignment="Center" Margin="0,4,0,0" TextAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <!-- ═══════ "ЛИСТИ" + ПОШУК ═══════ -->
                <Grid Grid.Row="3" Margin="16,0,16,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Функції" FontSize="16" FontWeight="SemiBold"
                               Foreground="#55555A" Margin="0,0,0,8"/>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0">
                                <TextBox Name="tb_SheetSearch" Height="30" Padding="13,0,0,0"
                                         Background="{StaticResource TableBackgroundBrush}"
                                         Foreground="White" BorderThickness="1"
                                         VerticalContentAlignment="Center"
                                         TextChanged="SheetSearch_TextChanged">
                                    <TextBox.Style>
                                        <Style TargetType="TextBox">
                                            <Setter Property="BorderBrush" Value="{StaticResource TableBorderBrush}"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsFocused" Value="True">
                                                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBox.Style>
                                    <TextBox.Template>
                                        <ControlTemplate TargetType="TextBox">
                                            <Border Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                                                <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </TextBox.Template>
                                </TextBox>

