<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Інсоляція мас" Width="400" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen">
  <StackPanel Margin="16">
    <TextBlock Text="Які блоки рахувати?" FontWeight="Bold" FontSize="16" Margin="0,0,0,6"/>

    <RadioButton x:Name="rb_sel" Content="Обрані блоки" IsChecked="True"/>
    <TextBlock Text="Рахуються блоки, обрані в моделі" FontSize="12"
               Foreground="#666" TextWrapping="Wrap" Margin="19,2,0,0"/>

    <RadioButton x:Name="rb_tag" Content="За параметрами" Margin="0,10,0,0"/>
    <TextBlock Text="Рахуються блоки із заданими значеннями AVR_Тип юніта і AVR_Номер Секції"
               FontSize="12" Foreground="#666" TextWrapping="Wrap" Margin="19,2,0,0"/>

    <TextBlock x:Name="tb_info" Margin="0,14,0,0" Foreground="#666"/>
    <Button x:Name="btn_next" Content="Далі" Height="30" Margin="0,16,0,0"
            Click="next_click"/>


  </StackPanel>
</Window>
