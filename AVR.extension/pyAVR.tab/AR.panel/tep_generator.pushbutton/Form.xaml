<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ТЕП — Генерація таблиці"
        Width="700" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        Background="#F7F7F7"
        FontFamily="Segoe UI"
        FontSize="13">

    <Window.Resources>

        <Style TargetType="Button">
            <Setter Property="Background"       Value="#E0CCFF"/>
            <Setter Property="Foreground"       Value="#3C3489"/>
            <Setter Property="BorderThickness"  Value="0"/>
            <Setter Property="Padding"          Value="16,6"/>
            <Setter Property="Cursor"           Value="Hand"/>
            <Setter Property="FontWeight"       Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#a7a1ff"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#E8E8E8"/>
                                <Setter Property="Foreground" Value="#AAAAAA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize"     Value="13"/>
            <Setter Property="FontWeight"   Value="SemiBold"/>
            <Setter Property="Foreground"   Value="#3C3489"/>
            <Setter Property="Margin"       Value="0,0,0,10"/>
        </Style>

        <Style x:Key="ColHeader" TargetType="TextBlock">
            <Setter Property="FontSize"     Value="11"/>
            <Setter Property="Foreground"   Value="#888780"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="BorderBrush"      Value="#CECBF6"/>
            <Setter Property="BorderThickness"  Value="1"/>
            <Setter Property="Padding"          Value="4,3"/>
            <Setter Property="Background"       Value="White"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="BorderBrush"  Value="#CECBF6"/>
            <Setter Property="Background"   Value="White"/>
            <Setter Property="Padding"      Value="4,2"/>
        </Style>

    </Window.Resources>

    <Border Padding="0,12,0,16" Background="#F7F7F7">
        <StackPanel>

            <!-- ══════════════ DO SELECTOR ══════════════ -->

            <StackPanel x:Name="DOSelect" Margin="12,0,12,12">

                <TextBlock Text="Вибір документів та дизайн-опцій"
                        Style="{StaticResource SectionTitle}"/>

                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="180"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="1" Text="Документ"     Style="{StaticResource ColHeader}"/>
                    <TextBlock Grid.Column="2" Text="Дизайн-опція" Style="{StaticResource ColHeader}"/>
                </Grid>

                <Rectangle Height="0.5" Fill="#EEEDFE" Margin="0,0,0,4"/>

                <ItemsControl x:Name="DocList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,5,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="180"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox Grid.Column="0"
                                        IsChecked="{Binding IsSelected}"
                                        VerticalAlignment="Center"
                                        Checked="OnCheckChanged"
                                        Unchecked="OnCheckChanged"/>
                                <TextBlock Grid.Column="1"
                                        Text="{Binding Name}"
                                        VerticalAlignment="Center"
                                        TextTrimming="CharacterEllipsis"
                                        ToolTip="{Binding Name}"/>
                                <ComboBox Grid.Column="2"
                                        ItemsSource="{Binding DesignOptions}"
                                        DisplayMemberPath="name"
                                        SelectedItem="{Binding SelectedDesignOption}"
                                        IsEnabled="{Binding IsSelected}"
                                        SelectionChanged="OnDesignOptionChanged"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Button x:Name="BtnConfirm"
                        Content="Підтвердити та парсити"
                        HorizontalAlignment="Right"
                        Margin="0,12,0,0"
                        Click="OnConfirmDO"/>

            </StackPanel>

            <!-- ══════════════ B VALIDATION ══════════════ -->

            <StackPanel x:Name="BValidation" Margin="12,0,12,12">

                <TextBlock Text="Перевірка номерів будівель та черг"
                        Style="{StaticResource SectionTitle}"/>

                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="160"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Модель"    Style="{StaticResource ColHeader}"/>
                    <TextBlock Grid.Column="1" Text="№ будівлі" Style="{StaticResource ColHeader}" Margin="8,0,0,0"/>
                    <TextBlock Grid.Column="2" Text="№ черги"   Style="{StaticResource ColHeader}" Margin="8,0,0,0"/>
                </Grid>

                <Rectangle Height="0.5" Fill="#EEEDFE" Margin="0,0,0,4"/>

                <ItemsControl x:Name="BuildingList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,5,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="160"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                        Text="{Binding name}"
                                        VerticalAlignment="Center"
                                        TextTrimming="CharacterEllipsis"
                                        ToolTip="{Binding name}"/>
                                <TextBox Grid.Column="1"
                                        Text="{Binding b_number}"
                                        Margin="8,0,0,0"
                                        TextChanged="OnBNumberChanged"/>
                                <TextBox Grid.Column="2"
                                        Text="{Binding b_dev_phase}"
                                        Margin="8,0,0,0"
                                        TextChanged="OnBDevPhaseChanged"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Button x:Name="BtnConfirmB"
                        Content="Підтвердити"
                        HorizontalAlignment="Right"
                        Margin="0,12,0,0"
                        Click="OnConfirmB"/>

            </StackPanel>

            <!-- ══════════════ MERGE MODELS ══════════════ -->

            <StackPanel x:Name="MergeCheck" Margin="12,0,12,12" Visibility="Collapsed">

                <TextBlock Text="Об'єднання будівель (опціонально)" 
                           Style="{StaticResource SectionTitle}"/>
                <TextBlock Text="Оберіть будівлі в межах однієї черги та натисніть 'Об'єднати вибрані'." 
                           Foreground="#888780" Margin="0,0,0,10" TextWrapping="Wrap"/>

                <ItemsControl x:Name="PhaseMergeList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderThickness="1" BorderBrush="#CECBF6" CornerRadius="4" Margin="0,0,0,8" Padding="10">
                                <StackPanel>
                                    <TextBlock Text="{Binding PhaseName, StringFormat='Черга {0}'}" 
                                               FontWeight="SemiBold" Foreground="#3C3489" Margin="0,0,0,8"/>
                                    
                                    <ItemsControl ItemsSource="{Binding MergeGroups}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="24"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    
                                                    <CheckBox Grid.Column="0" 
                                                              IsChecked="{Binding IsSelected}" 
                                                              VerticalAlignment="Center" 
                                                              Visibility="{Binding CheckBoxVisibility}"/>
                                                    
                                                    <TextBlock Grid.Column="1" 
                                                               Text="{Binding DisplayName}" 
                                                               VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    
                                                    <Button Grid.Column="2" Content="✕ Скасувати" 
                                                            Background="Transparent" Foreground="#D9534F" 
                                                            Padding="6,2" Cursor="Hand"
                                                            Visibility="{Binding UndoVisibility}"
                                                            Click="OnUndoMergeClick" 
                                                            Tag="{Binding .}"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    
                                    <Button Content="Об'єднати вибрані" 
                                            HorizontalAlignment="Left" Margin="24,8,0,0"
                                            Padding="12,4" Background="#EEEDFE" Foreground="#534AB7"
                                            Click="OnMergeSelectedClick" 
                                            Tag="{Binding .}"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Button x:Name="BtnConfirmMerge"
                        Content="Підтвердити об'єднання"
                        HorizontalAlignment="Right"
                        Margin="0,12,0,0"
                        Click="OnConfirmMerge"/>

            </StackPanel>

            <!-- ══════════════ FLOOR CHECK ══════════════ -->

            <StackPanel x:Name="FloorCheck" Margin="12,0,12,12">

                <TextBlock Text="Перевірка поверхів"
                        Style="{StaticResource SectionTitle}"/>

                <ItemsControl x:Name="ModelList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderThickness="1" BorderBrush="#CECBF6"
                                    CornerRadius="4" Margin="0,0,0,6">
                                <StackPanel>

                                    <Grid Background="White" Cursor="Hand"
                                        MouseLeftButtonDown="OnModelHeaderClick">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="24"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                Text="{Binding model_name}"
                                                FontWeight="SemiBold"
                                                Foreground="#3C3489"
                                                Margin="10,8,0,8"
                                                VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1"
                                                x:Name="Arrow"
                                                Text="▼"
                                                Foreground="#888780"
                                                VerticalAlignment="Center"
                                                HorizontalAlignment="Center"
                                                Margin="0,0,8,0"/>
                                    </Grid>

                                    <StackPanel x:Name="LevelBody"
                                                Background="#EEEDFE"
                                                Visibility="Collapsed">

                                        <Grid Margin="10,8,10,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="90"/>
                                                <ColumnDefinition Width="130"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text=""/>
                                            <TextBlock Grid.Column="1" Text="Цоколь"
                                                    FontSize="11" Foreground="#534AB7"
                                                    HorizontalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="Будівельний поверх"
                                                    FontSize="11" Foreground="#534AB7"
                                                    HorizontalAlignment="Center"
                                                    TextWrapping="Wrap"/>
                                        </Grid>

                                        <Rectangle Height="0.5" Fill="#AFA9EC" Margin="10,0,10,4"/>

                                        <ItemsControl ItemsSource="{Binding levels}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="10,4,10,4">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="90"/>
                                                            <ColumnDefinition Width="130"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0"
                                                                Text="{Binding level_name}"
                                                                VerticalAlignment="Center"
                                                                FontSize="13"/>
                                                        <CheckBox Grid.Column="1"
                                                                IsChecked="{Binding is_podium}"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"
                                                                Checked="OnPodiumChanged"
                                                                Unchecked="OnPodiumChanged"/>
                                                        <CheckBox Grid.Column="2"
                                                                IsChecked="{Binding is_building}"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"
                                                                Checked="OnBuildingChanged"
                                                                Unchecked="OnBuildingChanged"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <Rectangle Height="6" Fill="Transparent"/>
                                    </StackPanel>

                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Button x:Name="BtnConfirmFloors"
                        Content="Підтвердити поверхи"
                        HorizontalAlignment="Right"
                        Margin="0,12,0,0"
                        Click="OnConfirmFloors"/>

            </StackPanel>

            <!-- ══════════════ MANUAL FIELD FILLING ══════════════ -->
            
            <StackPanel x:Name="FieldFill" Margin="12,0,12,12">

                <TextBlock Text="Заповнення додаткових полів"
                        Style="{StaticResource SectionTitle}"/>

                <!-- project name / address -->
                <StackPanel x:Name="ProjectInfo" Margin="0,0,0,14">
                    <TextBlock Text="Найменування проекту і адреса"
                            FontWeight="SemiBold" Margin="0,0,0,8"/>

                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Найменування"
                                Style="{StaticResource ColHeader}"
                                VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" x:Name="ProjectName"
                                TextChanged="OnProjectNameChanged"
                                TextWrapping="Wrap" AcceptsReturn="True"/>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Адреса"
                                Style="{StaticResource ColHeader}"
                                VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" x:Name="ProjectAddress"
                                TextChanged="OnProjectAddressChanged"
                                TextWrapping="Wrap" AcceptsReturn="True"/>
                    </Grid>
                </StackPanel>

                <!-- per-building params -->
                <TextBlock Text="Параметри по будівлях"
                        FontWeight="SemiBold" Margin="0,0,0,8"/>

                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="2" Text="Гранична висота (м)"
                            Style="{StaticResource ColHeader}"
                            TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center"/>
                    <TextBlock Grid.Column="3" Text="Ступінь вогнестійкості"
                            Style="{StaticResource ColHeader}"
                            TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center"/>
                    <TextBlock Grid.Column="4" Text="Клас енергоефективності"
                            Style="{StaticResource ColHeader}"
                            TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center"/>
                    <TextBlock Grid.Column="5" Text="Тривалість будівництва"
                            Style="{StaticResource ColHeader}"
                            TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center"/>
                </Grid>

                <Rectangle Height="0.5" Fill="#EEEDFE" Margin="0,0,0,4"/>

                <ItemsControl x:Name="ManualParamsList" Margin="0,0,0,14">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,6,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="60"/>
                                    <ColumnDefinition Width="60"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                        Text="{Binding dev_phase_id, StringFormat='Черга {0}'}"
                                        Style="{StaticResource ColHeader}"
                                        VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1"
                                        Text="{Binding building_id, StringFormat='Буд {0}'}"
                                        Style="{StaticResource ColHeader}"
                                        VerticalAlignment="Center"/>
                                <TextBox Grid.Column="2" Tag="Float"
                                        TextChanged="OnHeightChanged"
                                        ToolTip="Числове значення у метрах"
                                        Margin="4,0"
                                        Text="{Binding height, Mode=TwoWay}"/>
                                <TextBox Grid.Column="3"
                                        TextChanged="OnFireRatingChanged"
                                        Margin="4,0"
                                        Text="{Binding fire_rating, Mode=TwoWay}"/>
                                <TextBox Grid.Column="4"
                                        TextChanged="OnEnergyClassChanged"
                                        Margin="4,0"
                                        Text="{Binding energy_class, Mode=TwoWay}"/>
                                <TextBox Grid.Column="5" Tag="Float"
                                        TextChanged="OnDurationChanged"
                                        ToolTip="Числове значення у місяцях"
                                        Margin="4,0"
                                        Text="{Binding duration, Mode=TwoWay}"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- optional rows -->
                <TextBlock Text="Включення полів"
                        FontWeight="SemiBold" Margin="0,0,0,8"/>

                <Rectangle Height="0.5" Fill="#EEEDFE" Margin="0,0,0,8"/>

                <Grid Margin="0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <CheckBox Grid.Column="0" x:Name="ShowTypeOfConstruction"
                            VerticalAlignment="Center" Margin="0,0,10,0"
                            Checked="IncludeTypeOfConstructionRow"
                            Unchecked="IncludeTypeOfConstructionRow"/>
                    <TextBlock Grid.Column="1" Text="Вид будівництва"
                            VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBox Grid.Column="2" x:Name="TypeOfConstruction"
                            TextChanged="TypeOfConstructionChanged"/>
                </Grid>

                <Grid Margin="0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <CheckBox Grid.Column="0" x:Name="ShowPropertyArea"
                            VerticalAlignment="Center" Margin="0,0,10,0"
                            Checked="IncludePropertyAreaRow"
                            Unchecked="IncludePropertyAreaRow"/>
                    <TextBlock Grid.Column="1" Text="Площа земельної ділянки"
                            VerticalAlignment="Center"/>
                </Grid>

                <Grid Margin="0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <CheckBox Grid.Column="0" x:Name="ShowCommonArea"
                            VerticalAlignment="Center" Margin="0,0,10,0"
                            Checked="IncludeCommonRoomsAreaRow"
                            Unchecked="IncludeCommonRoomsAreaRow"/>
                    <TextBlock Grid.Column="1"
                            Text="Площа приміщень загального користування"
                            VerticalAlignment="Center"/>
                </Grid>

                <Grid Margin="0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <CheckBox Grid.Column="0" x:Name="ShowParkingSpotsArea"
                            VerticalAlignment="Center" Margin="0,0,10,0"
                            Checked="IncludeParkingSpotsTotalAreaRow"
                            Unchecked="IncludeParkingSpotsTotalAreaRow"/>
                    <TextBlock Grid.Column="1" Text="Площа парковки"
                            VerticalAlignment="Center"/>
                </Grid>

                <Grid Margin="0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <CheckBox Grid.Column="0" x:Name="ShowTotalVolume"
                            VerticalAlignment="Center" Margin="0,0,10,0"
                            Checked="IncludeTotalValumeRow"
                            Unchecked="IncludeTotalValumeRow"/>
                    <TextBlock Grid.Column="1" Text="Загальний будівельний об'єм"
                            VerticalAlignment="Center"/>
                </Grid>

                <Button x:Name="BtnConfirmManualData"
                        Content="Підтвердити"
                        HorizontalAlignment="Right"
                        Margin="0,16,0,0"
                        Click="OnConfirmManualData"/>

            </StackPanel>
        </StackPanel>
    </Border>

</Window>
