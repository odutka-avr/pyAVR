<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Room Data Setup" Width="460"
        SizeToContent="Height" MaxHeight="900"
        WindowStartupLocation="CenterScreen"
        Background="#F7F7F7"
        FontFamily="Segoe UI"
        FontSize="13">

    <Window.Resources>

        <Style TargetType="Button">
            <Setter Property="Background"       Value="#E0CCFF"/>
            <Setter Property="Foreground"       Value="#3C3489"/>
            <Setter Property="BorderThickness"  Value="0"/>
            <Setter Property="Padding"          Value="16,6"/>
            <Setter Property="Cursor"           Value="Hand"/>
            <Setter Property="FontWeight"       Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#a7a1ff"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#E8E8E8"/>
                                <Setter Property="Foreground" Value="#AAAAAA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize"     Value="13"/>
            <Setter Property="FontWeight"   Value="SemiBold"/>
            <Setter Property="Foreground"   Value="#3C3489"/>
            <Setter Property="Margin"       Value="0,0,0,10"/>
        </Style>

        <Style x:Key="ColHeader" TargetType="TextBlock">
            <Setter Property="FontSize"     Value="11"/>
            <Setter Property="Foreground"   Value="#888780"/>
        </Style>

        <Style x:Key="RoomNamesText" TargetType="TextBlock">
            <Setter Property="FontSize"       Value="11"/>
            <Setter Property="Foreground"     Value="Gray"/>
            <Setter Property="TextWrapping"   Value="Wrap"/>
            <Setter Property="Margin"         Value="0,0,0,4"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="BorderBrush"      Value="#CECBF6"/>
            <Setter Property="BorderThickness"  Value="1"/>
            <Setter Property="Padding"          Value="4,3"/>
            <Setter Property="Background"       Value="White"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="BorderBrush"  Value="#CECBF6"/>
            <Setter Property="Background"   Value="White"/>
            <Setter Property="Padding"      Value="4,2"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#3C3489"/>
        </Style>

        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="#3C3489"/>
        </Style>

        <Style TargetType="Slider">
            <Setter Property="Foreground" Value="#8E7CC3"/>
        </Style>

    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="15">

            <!-- SECTION 0: Area rounding -->
            <StackPanel Margin="0,0,0,15">
                <TextBlock Text="1. Заокруглення площі"
                        Style="{StaticResource SectionTitle}"/>
                <StackPanel Orientation="Horizontal">
                    <Slider x:Name="slider_rounding"
                            Minimum="0" Maximum="3"
                            Value="2"
                            Width="250"
                            IsSnapToTickEnabled="True"
                            TickFrequency="1"
                            SmallChange="1"
                            ValueChanged="on_rounding_changed"
                            VerticalAlignment="Center"/>
                    <TextBlock x:Name="lbl_rounding_value"
                            Text="2"
                            Margin="10,0,0,0"
                            FontSize="13"
                            Foreground="#3C3489"
                            VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>


            <!-- SECTION 1: Design Option -->
            <TextBlock Text="2. Виберіть дизайн опцію"
                       Style="{StaticResource SectionTitle}"/>
            <ComboBox x:Name="combo_do" Height="28"
                      SelectionChanged="on_do_selected"/>

            <!-- Loading indicator -->
            <TextBlock x:Name="lbl_loading" Foreground="#888780"
                       Visibility="Collapsed" Margin="0,6,0,0"/>

            <!-- Include sills/doorsteps checkbox -->
            <CheckBox x:Name="chk_include_sills"
                      Content="Врахувати площу порогів у площах приміщень"
                      FontWeight="SemiBold"
                      Visibility="Collapsed"
                      Margin="0,20,0,10"/>

            <!-- SECTION 2: Room Type Coefficients -->
            <StackPanel x:Name="panel_room_types" Visibility="Collapsed" Margin="0,10,0,0">
                <TextBlock Text="3. Коефіцієнти типів приміщень"
                           Style="{StaticResource SectionTitle}"/>
                <ItemsControl x:Name="items_room_types">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderThickness="0,0,0,1" BorderBrush="#EEEDFE" Padding="0,0,0,6" Margin="0,0,0,6">
                                <StackPanel>
                                    <Grid Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="100"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Label}"
                                                   Foreground="#3C3489"
                                                   VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="1"
                                                 Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                                 HorizontalContentAlignment="Center"/>
                                    </Grid>
                                    <TextBlock Text="{Binding RoomNames}"
                                               Style="{StaticResource RoomNamesText}"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- SECTION 3: Per-building widths -->
            <StackPanel x:Name="panel_finish_width" Visibility="Collapsed" Margin="0,15,0,0">
                <TextBlock Text="4. Товщина штукатурки"
                            Style="{StaticResource SectionTitle}"/>

                <StackPanel x:Name="choice_building_section" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Різна товщина для різних будівель?"
                                Foreground="#3C3489"
                                VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <RadioButton x:Name="radio_buildings_yes" Content="Так"
                                    Checked="on_buildings_yes"
                                    VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <RadioButton x:Name="radio_buildings_no" Content="Ні"
                                    Checked="on_buildings_no"
                                    VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>

                <ItemsControl x:Name="items_building_sections" Visibility="Collapsed">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="100"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Label}"
                                           Foreground="#3C3489"
                                           VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1"
                                         Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                         HorizontalContentAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel x:Name="panel_global_width" Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="100"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Глобальна товщина штукатурки (мм)"
                                   Foreground="#3C3489"
                                   VerticalAlignment="Center"/>
                        <TextBox x:Name="txt_global_width" Grid.Column="1"
                                 Text="0" HorizontalContentAlignment="Center"/>
                    </Grid>
                </StackPanel>

            </StackPanel>


            <!-- SECTION 4: Omit Categories -->
            <StackPanel x:Name="panel_categories" Visibility="Collapsed" Margin="0,15,0,0">
                <TextBlock Text="5. Виключити вибрані категорії із вирахування площі штукатурки"
                           Style="{StaticResource SectionTitle}"/>
                <TextBlock Text="Виберіть категорії, з яких не буде вираховуватися площа штукатурки:"
                           Foreground="#888780" FontSize="11" Margin="0,0,0,6"/>
                <ItemsControl x:Name="items_categories">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <CheckBox Content="{Binding Label}"
                                      IsChecked="{Binding IsChecked}"
                                      Margin="0,3"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- Error + Confirm -->
            <TextBlock x:Name="lbl_error" Foreground="#D9534F"
                       Visibility="Collapsed" Margin="0,10,0,0"
                       TextWrapping="Wrap"/>

            <StackPanel x:Name="panel_confirm" Visibility="Collapsed">
                <Button Content="Підтвердити" Click="on_confirm"
                        HorizontalAlignment="Right"
                        Margin="0,15,0,5"/>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Window>
