<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Froglet"
        Height="860" Width="1440"
        MinHeight="520" MinWidth="820"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        ShowInTaskbar="True"
        FontFamily="Roboto Condensed, Segoe UI"
        Background="White">

    <!-- Custom title bar: the tab strip row IS the caption (draggable, double-
         click maximises); min/max/close are drawn by this window itself (see
         CaptionButtonsPanel) instead of the system title bar above the tabs. -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="46" GlassFrameThickness="0" CornerRadius="0"
                            UseAeroCaptionButtons="False"
                            ResizeBorderThickness="{x:Static SystemParameters.WindowResizeBorderThickness}" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="CaptionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="46" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#171C21" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#D5D7DA" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CaptionCloseButtonStyle" TargetType="Button" BasedOn="{StaticResource CaptionButtonStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}">
                            <ContentPresenter x:Name="Glyph" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#C42B1C" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- AVR Development design system tokens (see the "AVR Development
             Design System" artifact) - restrained near-monochrome graphite
             palette, a single sharp avr-radius (2px) everywhere instead of
             the soft pill look this window used before, ExtraLight/Light
             Montserrat for display text, Roboto Condensed (set on the
             Window itself above, so every control inherits it) for body
             copy. Same structure/behaviour throughout - only re-skinned. -->
        <SolidColorBrush x:Key="AvrInkBrush" Color="#171C21" />
        <SolidColorBrush x:Key="AvrTextMutedBrush" Color="#5C636B" />
        <SolidColorBrush x:Key="AvrTextFaintBrush" Color="#8F949C" />
        <SolidColorBrush x:Key="AvrLineBrush" Color="#E2E4E6" />
        <SolidColorBrush x:Key="AvrLineStrongBrush" Color="#C8CBCF" />
        <SolidColorBrush x:Key="AvrSelectBrush" Color="#ECECEE" />
        <SolidColorBrush x:Key="AvrBgBrush" Color="#E9EAEC" />
        <SolidColorBrush x:Key="AvrRustBrush" Color="#8A3B2A" />

        <!-- Pill-style toggle used for apartment-type / window-placement / added-part filters -->
        <Style x:Key="FilterToggleStyle" TargetType="ToggleButton">
            <Setter Property="Margin" Value="0,0,10,8" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="MinWidth" Value="64" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="{StaticResource AvrLineStrongBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Background" Value="#171C21" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Pill-style single-select used for card-size / page-size pickers -
             sized to match the compact Sort combo box. -->
        <Style x:Key="PickerRadioStyle" TargetType="RadioButton">
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="MinWidth" Value="26" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="{StaticResource AvrLineStrongBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Background" Value="#171C21" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GroupHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource AvrInkBrush}" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <Style x:Key="ErrorTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource AvrRustBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="0,2,0,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <!-- Flat section: no card background/border, just a thin
             separator line under each one. -->
        <Style x:Key="SectionBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="#ECEEEC" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="0,12" />
            <Setter Property="Margin" Value="0" />
        </Style>

        <!-- Thin, borderless vertical/horizontal scrollbar: no arrow
             buttons, no track background, just a slim rounded thumb. -->
        <Style x:Key="SlimScrollThumbStyle" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="ThumbBorder" Background="#C8CBCF" CornerRadius="1.5" Margin="0" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbBorder" Property="Background" Value="#8F949C" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbBorder" Property="Background" Value="#5C636B" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SlimTrackButtonStyle" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="0.75" />
            <Setter Property="Height" Value="Auto" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource SlimTrackButtonStyle}" />
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource SlimScrollThumbStyle}" />
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource SlimTrackButtonStyle}" />
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto" />
                    <Setter Property="Height" Value="0.75" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Track x:Name="PART_Track">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageLeftCommand" Style="{StaticResource SlimTrackButtonStyle}" />
                                    </Track.DecreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource SlimScrollThumbStyle}" />
                                    </Track.Thumb>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageRightCommand" Style="{StaticResource SlimTrackButtonStyle}" />
                                    </Track.IncreaseRepeatButton>
                                </Track>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ScrollViewer whose scrollbars have an explicit 8px width set in
             the template itself (a local value, so it cannot be lost to the
             theme/implicit style) - the implicit ScrollBar style above only
             supplies the slim look. -->
        <Style x:Key="ThinScrollViewerStyle" TargetType="ScrollViewer">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid Background="{TemplateBinding Background}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <ScrollContentPresenter Grid.Column="0" Grid.Row="0"
                                                    CanContentScroll="{TemplateBinding CanContentScroll}"
                                                    Margin="{TemplateBinding Padding}" />
                            <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Column="1" Grid.Row="0"
                                       Orientation="Vertical" Width="4" MinWidth="4"
                                       Value="{TemplateBinding VerticalOffset}"
                                       Maximum="{TemplateBinding ScrollableHeight}"
                                       ViewportSize="{TemplateBinding ViewportHeight}"
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" />
                            <ScrollBar x:Name="PART_HorizontalScrollBar" Grid.Column="0" Grid.Row="1"
                                       Orientation="Horizontal" Height="4" MinHeight="4"
                                       Value="{TemplateBinding HorizontalOffset}"
                                       Maximum="{TemplateBinding ScrollableWidth}"
                                       ViewportSize="{TemplateBinding ViewportWidth}"
                                       Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- White action button (same look as an unselected filter pill) that
             flashes black for ~1s when clicked, then fades back to white. -->
        <!-- Expander with just the chevron - no circle around it. -->
        <Style x:Key="GroupExpanderStyle" TargetType="Expander">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <DockPanel>
                            <ToggleButton DockPanel.Dock="Top" Cursor="Hand" Focusable="False"
                                          Content="{TemplateBinding Header}"
                                          Foreground="{TemplateBinding Foreground}"
                                          Background="{TemplateBinding Background}"
                                          HorizontalContentAlignment="Stretch"
                                          IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{TemplateBinding Background}" Padding="6,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="22" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Path x:Name="Chevron" Data="M 0,0 L 4.5,4.5 L 9,0"
                                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                                      StrokeThickness="1.6"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      RenderTransformOrigin="0.5,0.5">
                                                    <Path.RenderTransform>
                                                        <RotateTransform Angle="0" />
                                                    </Path.RenderTransform>
                                                </Path>
                                                <ContentPresenter Grid.Column="1" VerticalAlignment="Center"
                                                                  HorizontalAlignment="Stretch" />
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Chevron" Property="RenderTransform">
                                                    <Setter.Value>
                                                        <RotateTransform Angle="180" />
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ExpandSite" DockPanel.Dock="Bottom"
                                              Visibility="Collapsed"
                                              TextElement.Foreground="#171C21" />
                        </DockPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The same drop-down as GroupExpanderStyle, but the chevron sits level with the FIRST line of the
             header (the title), not in the middle of title + subtitle. -->
        <Style x:Key="SectionExpanderStyle" TargetType="Expander">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <DockPanel>
                            <ToggleButton DockPanel.Dock="Top" Cursor="Hand" Focusable="False"
                                          Content="{TemplateBinding Header}"
                                          Foreground="{TemplateBinding Foreground}"
                                          Background="{TemplateBinding Background}"
                                          HorizontalContentAlignment="Stretch"
                                          IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{TemplateBinding Background}" Padding="6,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="32" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Path x:Name="Chevron" Data="M 0,0 L 8,8 L 16,0"
                                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                                      StrokeThickness="2.6"
                                                      HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,14,0,0"
                                                      RenderTransformOrigin="0.5,0.5">
                                                    <Path.RenderTransform>
                                                        <RotateTransform Angle="0" />
                                                    </Path.RenderTransform>
                                                </Path>
                                                <ContentPresenter Grid.Column="1" VerticalAlignment="Center"
                                                                  HorizontalAlignment="Stretch" />
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Chevron" Property="RenderTransform">
                                                    <Setter.Value>
                                                        <RotateTransform Angle="180" />
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ExpandSite" DockPanel.Dock="Bottom"
                                              Visibility="Collapsed"
                                              TextElement.Foreground="#171C21" />
                        </DockPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Plain text button: no box, no background; underline on hover.
             Foreground is set from code (it flips white on a selected group). -->
        <Style x:Key="ChooseTextButtonStyle" TargetType="Button">
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                            <TextBlock x:Name="Label" Text="{TemplateBinding Content}"
                                       Foreground="{TemplateBinding Foreground}"
                                       VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Label" Property="TextDecorations" Value="Underline" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Same look as FlashActionButtonStyle but permanently black: swapped in
             from code while a Revit pick is in progress. -->
        <Style x:Key="ActiveActionButtonStyle" TargetType="Button">
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="#171C21" BorderBrush="#171C21"
                                BorderThickness="1" CornerRadius="2" Padding="{TemplateBinding Padding}">
                            <TextElement.Foreground>
                                <SolidColorBrush Color="White" />
                            </TextElement.Foreground>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FlashActionButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="#171C21" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" BorderBrush="{StaticResource AvrLineStrongBrush}"
                                BorderThickness="1" CornerRadius="2" Padding="{TemplateBinding Padding}">
                            <Border.Background>
                                <SolidColorBrush Color="White" />
                            </Border.Background>
                            <TextElement.Foreground>
                                <SolidColorBrush Color="#171C21" />
                            </TextElement.Foreground>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="Button.Click">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimationUsingKeyFrames Storyboard.TargetName="Bd"
                                                Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)">
                                            <DiscreteColorKeyFrame KeyTime="0:0:0" Value="#171C21" />
                                            <LinearColorKeyFrame KeyTime="0:0:0.6" Value="#171C21" />
                                            <LinearColorKeyFrame KeyTime="0:0:1.0" Value="White" />
                                        </ColorAnimationUsingKeyFrames>
                                        <ColorAnimationUsingKeyFrames Storyboard.TargetName="Bd"
                                                Storyboard.TargetProperty="(TextElement.Foreground).(SolidColorBrush.Color)">
                                            <DiscreteColorKeyFrame KeyTime="0:0:0" Value="White" />
                                            <LinearColorKeyFrame KeyTime="0:0:0.6" Value="White" />
                                            <LinearColorKeyFrame KeyTime="0:0:1.0" Value="#171C21" />
                                        </ColorAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sharp-cornered primary action button ("Запустити") - avr-ink,
             the same dark tone as a selected/checked filter pill. -->
        <Style x:Key="PrimaryActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#171C21" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="2"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#33353D" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#8F949C" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ExtraLight/Light Montserrat display voice - falls back to
             Segoe UI if Montserrat isn't installed on this machine. -->
        <Style x:Key="ColumnTitleStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Montserrat Light, Montserrat, Segoe UI" />
            <Setter Property="FontSize" Value="28" />
            <Setter Property="FontWeight" Value="Light" />
            <Setter Property="Foreground" Value="{StaticResource AvrInkBrush}" />
        </Style>

        <!-- The window speaks in three voices: the title (ColumnTitleStyle), the subtitle and the plain text. -->
        <Style x:Key="ColumnSubtitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17" />
            <Setter Property="Foreground" Value="{StaticResource AvrTextMutedBrush}" />
            <Setter Property="Margin" Value="0,3,0,0" />
        </Style>

        <!-- The plain text: a little smaller than the subtitle, the same grey, not bold. -->
        <Style x:Key="BodyTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Foreground" Value="{StaticResource AvrTextMutedBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <!-- Applied to every plain TextBox in the window (area/dimensions
             inputs) so they match the rounded pill look used elsewhere,
             without needing Style="..." repeated on each one. -->
        <Style TargetType="TextBox">
            <!-- Vertical component (5) matches FilterToggleStyle's own
                 Padding="8,5" - so a text input and a pill button
                 standing next to each other render at the exact same
                 height. -->
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource AvrLineStrongBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Applied to every plain Button (the pagination buttons built
             dynamically in Python) - RunButton has its own explicit
             style below, which wins over this implicit one. -->
        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource AvrLineStrongBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource AvrSelectBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource AvrTextFaintBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Applied to the Sort combo box. -->
        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource AvrLineStrongBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                          Focusable="False" ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="2">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="20" />
                                                </Grid.ColumnDefinitions>
                                                <Path Grid.Column="1" Data="M0,0 L4,4 L8,0 Z" Fill="#5C636B"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ContentSite"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left" />
                            <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Border Background="White" BorderBrush="{StaticResource AvrLineStrongBrush}" BorderThickness="1" CornerRadius="2"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="220">
                                    <ScrollViewer SnapsToDevicePixels="True">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Chrome-like tab headers - "Банк квартир" (BankTabItem, never
             closed) plus one per apartment opened from a card (added/
             removed dynamically in Python - see _open_apartment_detail_
             tab and its own middle-click-to-close handler). Only the
             TabItem itself is restyled here - TabControl keeps its own
             default template (a fully custom one risks a silently blank
             content area if PART_SelectedContentHost isn't wired exactly
             right), so the strip's own background is whatever the
             default theme gives it, but every individual tab still reads
             as flat/rounded like the rest of this window's own controls. -->
        <Style x:Key="ChromeTabItemStyle" TargetType="TabItem">
            <!-- Shorter than the 40px tab-strip row on purpose, and the
                 TabPanel below is bottom-aligned within that row - leaves
                 a small sliver of the row's own background colour ABOVE
                 each tab, matching Chrome's own look (the tab "floats" up
                 from the bottom of the strip rather than filling it). -->
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource AvrTextMutedBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Grid>
                            <Border x:Name="TabBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderThickness="0"
                                    CornerRadius="6,6,0,0"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter x:Name="ContentSite"
                                                  ContentSource="Header"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                            </Border>
                            <!-- Chrome-style separator between unselected tabs -->
                            <Rectangle x:Name="TabSeparator" Width="1" Height="16"
                                       Fill="#C8CBCF" HorizontalAlignment="Right"
                                       VerticalAlignment="Center" IsHitTestVisible="False" />
                            <!-- Chrome-style flared feet: concave corners that curve
                                 outwards where the selected tab meets the content. -->
                            <Path x:Name="LeftFoot" Visibility="Collapsed" Fill="White"
                                  Width="12" Height="12" Margin="-12,0,0,0"
                                  HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                  Data="M12,0 L12,12 L0,12 A12,12 0 0 0 12,0 Z" IsHitTestVisible="False" />
                            <Path x:Name="RightFoot" Visibility="Collapsed" Fill="White"
                                  Width="12" Height="12" Margin="0,0,-12,0"
                                  HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                  Data="M0,0 L0,12 L12,12 A12,12 0 0 1 0,0 Z" IsHitTestVisible="False" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="LeftFoot" Property="Visibility" Value="Visible" />
                                <Setter TargetName="RightFoot" Property="Visibility" Value="Visible" />
                                <Setter TargetName="TabBorder" Property="Background" Value="White" />
                                <Setter TargetName="TabSeparator" Property="Visibility" Value="Hidden" />
                                <Setter Property="Foreground" Value="#171C21" />
                                <Setter Property="Panel.ZIndex" Value="1" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="False">
                                <Setter Property="Cursor" Value="Hand" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid x:Name="RootContentGrid">
    <TabControl x:Name="MainTabControl" Background="White" BorderThickness="0" Padding="0">
    <TabControl.Template>
        <ControlTemplate TargetType="TabControl">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <!-- Tab strip only - the app icon lives INSIDE BankTabItem's
                     own Header (see below), since Header content is
                     ordinary content, not template structure. TabPanel is
                     bottom-aligned so the (shorter, see ChromeTabItemStyle)
                     tabs sit flush with the content area below, leaving a
                     small gap of this row's own background above them,
                     Chrome-style. -->
                <Grid Grid.Row="0" Height="46" Background="#E9EAEC">
                    <TabPanel IsItemsHost="True" Margin="18,0,180,0" VerticalAlignment="Bottom"
                              shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                </Grid>
                <Border Grid.Row="1" Background="White">
                    <ContentPresenter ContentSource="SelectedContent" />
                </Border>
            </Grid>
        </ControlTemplate>
    </TabControl.Template>
    <TabItem x:Name="BankTabItem" Style="{StaticResource ChromeTabItemStyle}" AllowDrop="True">
    <TabItem.Header>
        <StackPanel Orientation="Horizontal">
            <Image x:Name="BankIconImage" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center" />
            <TextBlock Text="Банк квартир" VerticalAlignment="Center" />
        </StackPanel>
    </TabItem.Header>
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="LeftColumnDefinition" Width="380" MinWidth="260" />
            <ColumnDefinition Width="6" />
            <ColumnDefinition Width="*" MinWidth="420" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <!-- Shared title row - Auto height takes the MAX of both
                 columns' titles, so the actual content below (filters /
                 toolbar+grid) always starts at the same Y in both
                 columns regardless of how many lines either title wraps
                 to. -->
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ============ TITLES (same row, both columns) ============ -->
        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,14">
            <TextBlock Text="Налаштування параметрів" Style="{StaticResource ColumnTitleStyle}" />
            <TextBlock Text="Параметри квартир" Style="{StaticResource ColumnSubtitleStyle}" />
        </StackPanel>

        <StackPanel Grid.Row="0" Grid.Column="2" Margin="12,0,0,14">
            <TextBlock Text="Банк квартир" Style="{StaticResource ColumnTitleStyle}" />
            <TextBlock Text="Квартири, що підходять за параметрами" Style="{StaticResource ColumnSubtitleStyle}" />
        </StackPanel>

        <!-- ============ LEFT COLUMN: filters + priorities ============ -->
        <Grid Grid.Row="1" Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

        <ScrollViewer Style="{StaticResource ThinScrollViewerStyle}" Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,8,0">

                <!-- Purely a blank spacer, window background colour (not
                     the grey card look) so it reads as empty space, not an
                     empty box. -->
                <Border x:Name="TypeSectionSpacer" Background="White" Height="25" Margin="0" />

                <Border Style="{StaticResource SectionBorderStyle}">
                    <StackPanel>
                        <!-- "Очистити все" only shows once a filter is changed (code: _sync_reset_filters_button). -->
                        <Grid MinHeight="22" Margin="0,0,10,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Кількість кімнат" Style="{StaticResource GroupHeaderStyle}" VerticalAlignment="Center" />
                            <Button x:Name="ResetFiltersButton" Grid.Column="1" Content="Очистити все" Visibility="Collapsed"
                                    Style="{StaticResource ChooseTextButtonStyle}" Foreground="#171C21"
                                    Padding="6,0" Margin="0,0,0,6" VerticalAlignment="Center"
                                    ToolTip="Скинути всі параметри на початкові" />
                        </Grid>
                        <UniformGrid Columns="4">
                            <ToggleButton x:Name="TypeStudioToggle" Tag="0" Content="Студіо" Style="{StaticResource FilterToggleStyle}" />
                            <ToggleButton x:Name="Type1Toggle" Tag="1" Content="1-к" Style="{StaticResource FilterToggleStyle}" />
                            <ToggleButton x:Name="Type2Toggle" Tag="2" Content="2-к" Style="{StaticResource FilterToggleStyle}" />
                            <ToggleButton x:Name="Type3Toggle" Tag="3" Content="3-к" Style="{StaticResource FilterToggleStyle}" />
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SectionBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="Площа квартири, м²" Style="{StaticResource GroupHeaderStyle}" />
                        <Grid Margin="0,0,10,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Мінімальна площа" FontSize="11" Foreground="#5C636B" />
                                <!-- Height from a toggle declared ABOVE these boxes (a binding to WPRToggle, which comes later in the file, was not resolved: the boxes stayed at their natural, smaller height). -->
                                <TextBox x:Name="AreaMinTextBox" Height="{Binding ActualHeight, ElementName=TypeStudioToggle}" Padding="8,0" VerticalContentAlignment="Center" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="—" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,6" />
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Максимальна площа" FontSize="11" Foreground="#5C636B" />
                                <TextBox x:Name="AreaMaxTextBox" Height="{Binding ActualHeight, ElementName=TypeStudioToggle}" Padding="8,0" VerticalContentAlignment="Center" />
                            </StackPanel>
                        </Grid>
                        <TextBlock x:Name="AreaErrorText" Style="{StaticResource ErrorTextStyle}" Text="" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SectionBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="Розташування вікон" Style="{StaticResource GroupHeaderStyle}" />
                        <!-- UniformGrid (not WrapPanel) so all 4 buttons are
                             exactly the same width and stretch edge-to-edge,
                             instead of each auto-sizing to its own label's
                             length ("Наскрізне" wider than "Рядове"). -->
                        <UniformGrid Columns="4">
                            <ToggleButton x:Name="WPRToggle" Tag="R" Content="Рядове" Style="{StaticResource FilterToggleStyle}" />
                            <ToggleButton x:Name="WPCToggle" Tag="C" Content="Кутове" Style="{StaticResource FilterToggleStyle}" />
                            <ToggleButton x:Name="WPLToggle" Tag="L" Content="Наскрізне" Style="{StaticResource FilterToggleStyle}" />
                            <ToggleButton x:Name="WPNToggle" Tag="N" Content="Торцеве" Style="{StaticResource FilterToggleStyle}" />
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SectionBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="Додана частина" Style="{StaticResource GroupHeaderStyle}" />
                        <UniformGrid Columns="4">
                            <ToggleButton x:Name="APAPToggle" Tag="AP" Content="Присутня" Style="{StaticResource FilterToggleStyle}" />
                            <ToggleButton x:Name="APNPToggle" Tag="NP" Content="Відсутня" Style="{StaticResource FilterToggleStyle}" />
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SectionBorderStyle}" BorderThickness="0">
                    <StackPanel>
                        <TextBlock Text="Номінальні розміри квартири, мм" Style="{StaticResource GroupHeaderStyle}" />
                        <Grid Margin="0,0,10,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Ширина" FontSize="11" Foreground="#5C636B" />
                                <TextBox x:Name="DimWidthTextBox" Height="{Binding ActualHeight, ElementName=WPRToggle}" Padding="8,0" VerticalContentAlignment="Center" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="×" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,6" />
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Довжина" FontSize="11" Foreground="#5C636B" />
                                <TextBox x:Name="DimLengthTextBox" Height="{Binding ActualHeight, ElementName=WPRToggle}" Padding="8,0" VerticalContentAlignment="Center" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="Похибка" FontSize="11" Foreground="#5C636B" />
                        <TextBox x:Name="DimToleranceTextBox" Margin="0,0,10,0" Height="{Binding ActualHeight, ElementName=WPRToggle}" Padding="8,0" VerticalContentAlignment="Center" />
                        <TextBlock x:Name="DimErrorText" Style="{StaticResource ErrorTextStyle}" Text="" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <TextBlock x:Name="StatusText" Grid.Row="1" TextWrapping="Wrap"
                   Foreground="#5C636B" FontSize="11" Margin="0,8,8,0" />

        </Grid>

        <!-- GridSplitter keeps the full 6px column as its drag hit-area
             (Transparent - narrowing IT to look like a thin line would
             also narrow the actual grab target, hard to click precisely)
             - the thin, darker VISIBLE line is a separate, non-interactive
             overlay so dragging stays easy but the line itself reads as
             crisp rather than a wide pale bar. -->
        <GridSplitter Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Width="6"
                      HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                      Background="Transparent" ResizeBehavior="PreviousAndNext" />
        <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Width="2"
                HorizontalAlignment="Center" VerticalAlignment="Stretch"
                Background="#C8CBCF" IsHitTestVisible="False" />

        <!-- ============ RIGHT COLUMN: apartment bank ============ -->
        <Grid Grid.Row="1" Grid.Column="2" Margin="12,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Toolbar - wrapped in a Border using the EXACT SAME Padding
                 (12) as SectionBorderStyle on the left column's first box
                 (Margin was an approximation and still left a few px of
                 drift, since a Margin-offset element's own children can
                 still shift further via VerticalAlignment="Center" against
                 a taller sibling like the ComboBox - Padding on a real
                 wrapper plus VerticalAlignment="Top" throughout removes
                 both sources of drift, so "Сортування:" lines up with
                 "Тип квартири" exactly, not approximately). -->
            <Border x:Name="ToolbarBorder" Grid.Row="0" Padding="0,12,0,8">
              <Grid VerticalAlignment="Top">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Top">
                    <TextBlock Text="Сортування:" VerticalAlignment="Top" Margin="0,4,6,0" />
                    <ComboBox x:Name="SortComboBox" Width="280" VerticalAlignment="Top">
                        <ComboBoxItem Tag="area-asc" Content="За площею від найменшого до найбільшого" />
                        <ComboBoxItem Tag="area-desc" Content="За площею від найбільшого до найменшого" />
                        <ComboBoxItem Tag="type-asc" Content="За типом від найменшого до найбільшого" />
                        <ComboBoxItem Tag="type-desc" Content="За типом від найбільшого до найменшого" />
                        <ComboBoxItem Tag="best-fit" Content="Найбільш підходяще" />
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top" Margin="12,0">
                    <TextBlock Text="Розмір:" VerticalAlignment="Top" Margin="0,4,6,0" />
                    <RadioButton x:Name="CardSizeSRadio" GroupName="CardSize" Tag="s" Content="S" Style="{StaticResource PickerRadioStyle}" VerticalAlignment="Top" />
                    <RadioButton x:Name="CardSizeMRadio" GroupName="CardSize" Tag="m" Content="M" Style="{StaticResource PickerRadioStyle}" VerticalAlignment="Top" />
                    <RadioButton x:Name="CardSizeLRadio" GroupName="CardSize" Tag="l" Content="L" Style="{StaticResource PickerRadioStyle}" VerticalAlignment="Top" />
                </StackPanel>

                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Top">
                    <TextBlock Text="На сторінці:" VerticalAlignment="Top" Margin="0,4,6,0" />
                    <RadioButton x:Name="PageSize8Radio" GroupName="PageSize" Tag="8" Content="8" Style="{StaticResource PickerRadioStyle}" VerticalAlignment="Top" />
                    <RadioButton x:Name="PageSize12Radio" GroupName="PageSize" Tag="12" Content="12" Style="{StaticResource PickerRadioStyle}" VerticalAlignment="Top" />
                    <RadioButton x:Name="PageSize20Radio" GroupName="PageSize" Tag="20" Content="20" Style="{StaticResource PickerRadioStyle}" VerticalAlignment="Top" />
                    <RadioButton x:Name="PageSize32Radio" GroupName="PageSize" Tag="32" Content="32" Style="{StaticResource PickerRadioStyle}" VerticalAlignment="Top" />
                </StackPanel>
              </Grid>
            </Border>

            <!-- Apartment grid - UniformGrid (not WrapPanel) so the
                 S/M/L card-size picker can force an EXACT column count
                 (5/3/2, set on ApartmentGridPanel.Columns in Python) that
                 always spans the full width edge-to-edge, rather than
                 however many happen to fit at each card's own fixed
                 pixel width. -->
            <Border Grid.Row="1" BorderBrush="#ECEEEC" BorderThickness="1" CornerRadius="2" Background="Transparent">
                <Grid>
                    <ScrollViewer Style="{StaticResource ThinScrollViewerStyle}" VerticalScrollBarVisibility="Auto" Padding="10">
                        <UniformGrid x:Name="ApartmentGridPanel" VerticalAlignment="Top" />
                    </ScrollViewer>
                    <TextBlock x:Name="EmptyStateText"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               TextAlignment="Center" TextWrapping="Wrap"
                               Foreground="#5C636B" FontSize="14" MaxWidth="380"
                               Visibility="Collapsed" />
                </Grid>
            </Border>

            <!-- Pagination + count + Запустити, all one row: PaginationPanel
                 left, PageCountText centered across the full row width,
                 RunButton right - three siblings sharing one Grid cell
                 rather than separate columns, so the centering doesn't
                 depend on how wide the other two happen to be. -->
            <Grid Grid.Row="2" Margin="0,8,0,0">
                <StackPanel x:Name="PaginationPanel" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" />
                <TextBlock x:Name="PageCountText" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="#5C636B" FontSize="12" />
                <Button x:Name="RunButton" Content="Запустити"
                        Style="{StaticResource PrimaryActionButtonStyle}"
                        MinWidth="130" Padding="18,9"
                        HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>

        </Grid>
    </Grid>
    </TabItem>
    <TabItem x:Name="PickTabItem" Style="{StaticResource ChromeTabItemStyle}" AllowDrop="True">
        <TabItem.Header>
            <StackPanel Orientation="Horizontal">
                <Image x:Name="PickIconImage" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center" />
                <TextBlock Text="Розпланування поверху" VerticalAlignment="Center" />
            </StackPanel>
        </TabItem.Header>
        <!-- Same outer layout as the "Банк квартир" tab (10px margin, button row
             8px below the content) so "Запустити" sits in exactly the same spot. -->
        <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <!-- Three rows, one under the other (they were three columns); each is a drop-down list: its title
             and subtitle are the header, its buttons and lists are inside. Closed at first. -->
        <ScrollViewer Grid.Row="0" Style="{StaticResource ThinScrollViewerStyle}" VerticalScrollBarVisibility="Auto" Margin="14,0,14,14">
        <StackPanel>
            <!-- 0. Ознайомлення: what the script is for (a list with bullets); the button beside the second item opens the "Банк квартир" tab.
                 Open when the window opens (_wire_stage_expanders). -->
            <Expander x:Name="AboutExpander" Style="{StaticResource SectionExpanderStyle}" IsExpanded="False">
                <Expander.Header>
                    <StackPanel>
                        <TextBlock Text="1. Про скрипт" Style="{StaticResource ColumnTitleStyle}" />
                        <TextBlock Text="Можливості та результат" TextWrapping="Wrap" Style="{StaticResource ColumnSubtitleStyle}" Margin="0,3,0,0" />
                    </StackPanel>
                </Expander.Header>
            <!-- The list stands farther from the subtitle (14) than its items from each other (10). -->
            <StackPanel Margin="28,14,0,24">
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Ellipse Grid.Column="0" Width="4" Height="4" Margin="2,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"
                             Fill="{StaticResource AvrTextMutedBrush}" />
                    <TextBlock Grid.Column="1" Style="{StaticResource BodyTextStyle}" VerticalAlignment="Center"
                               Text="Швидке розпланування поділеної на плями квартир посадки Tadpole готовими плануваннями квартир." />
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Ellipse Grid.Column="0" Width="4" Height="4" Margin="2,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"
                             Fill="{StaticResource AvrTextMutedBrush}" />
                    <!-- The button stands right after the text (and under it when the window is too narrow for both). -->
                    <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource BodyTextStyle}" TextWrapping="NoWrap" VerticalAlignment="Center" Margin="0,0,14,0"
                                   Text="Для ознайомлення з готовими плануваннями натисніть на кнопку" />
                        <Button x:Name="OpenBankButton" Content="Банк квартир"
                                Style="{StaticResource FlashActionButtonStyle}"
                                Padding="18,9" VerticalAlignment="Center" />
                    </WrapPanel>
                </Grid>
            </StackPanel>
            </Expander>
            <Border Height="1" Background="#C8CBCF" Margin="0,22,0,22" />
            <Expander x:Name="ViewCreationExpander" Style="{StaticResource SectionExpanderStyle}" IsExpanded="False">
                <Expander.Header>
                    <StackPanel>
                        <TextBlock Text="2. Вибір поверху" Style="{StaticResource ColumnTitleStyle}" />
                        <TextBlock Text="Виберіть roof на рівні якого знаходиться поверх, який ви хочете розпланувати, та виберіть геометрію яку будете розплановувати та підтвердьте натиснувши finish зверху зліва в Revit." TextWrapping="Wrap" Style="{StaticResource ColumnSubtitleStyle}" Margin="0,3,0,0" />
                    </StackPanel>
                </Expander.Header>
            <StackPanel Margin="28,6,0,24">
                <!-- Not used for now: hidden (its handler _on_sections_click / _choose_sections stay in the script). -->
                <Button x:Name="SelectSectionsButton" Content="Вибір секцій для розпланування"
                        Style="{StaticResource FlashActionButtonStyle}"
                        Padding="18,9" HorizontalAlignment="Left" Visibility="Collapsed" />

                <Button x:Name="SelectLevelSectionButton" Content="Вибір окремого поверху та квартир"
                        Style="{StaticResource FlashActionButtonStyle}"
                        Padding="18,9" HorizontalAlignment="Left" />
                <!-- Always there; "Поки не створено жодного плану поверху" while there are no created views. -->
                <StackPanel x:Name="CreatedViewsPanel">
                    <Border Height="1" Background="#ECEEEC" Margin="0,14,0,14" />
                    <TextBlock Text="Створені види:" FontWeight="SemiBold" Margin="19,0,0,8" />
                    <ScrollViewer Style="{StaticResource ThinScrollViewerStyle}" VerticalScrollBarVisibility="Auto" MaxHeight="520">
                        <ItemsControl x:Name="CreatedViewsList" />
                    </ScrollViewer>
                </StackPanel>
                <!-- Views created for the chosen building sections (below "Створені види"); shown only when there are some. -->
                <StackPanel x:Name="SectionViewsPanel" Visibility="Collapsed">
                    <Border Height="1" Background="#ECEEEC" Margin="0,14,0,14" />
                    <TextBlock Text="Створені види для секцій:" FontWeight="SemiBold" Margin="19,0,0,8" />
                    <ScrollViewer Style="{StaticResource ThinScrollViewerStyle}" VerticalScrollBarVisibility="Auto" MaxHeight="520">
                        <ItemsControl x:Name="SectionViewsList" />
                    </ScrollViewer>
                </StackPanel>
            </StackPanel>

            </Expander>
            <Border Height="1" Background="#C8CBCF" Margin="0,22,0,22" />
            <Expander x:Name="FootprintExpander" Style="{StaticResource SectionExpanderStyle}" IsExpanded="False">
                <Expander.Header>
                    <StackPanel>
                        <TextBlock Text="3. Підбір планувань" Style="{StaticResource ColumnTitleStyle}" />
                        <TextBlock Text="Заповнення плану поверху готовими рішеннями квартир" TextWrapping="Wrap" Style="{StaticResource ColumnSubtitleStyle}" Margin="0,3,0,0" />
                    </StackPanel>
                </Expander.Header>
            <StackPanel Margin="28,6,0,24">
                <!-- The scheme of the active floor (floor_scheme.py): every footprint with its type, area and nominal sizes;
                     a click chooses it. "Не відкрито жодного виду" when no plan Froglet made is open. -->
                <StackPanel x:Name="AvailableGroupsPanel">
                    <Grid Margin="0,10,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Ellipse Grid.Column="0" Width="4" Height="4" Margin="2,8,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"
                                 Fill="{StaticResource AvrTextMutedBrush}" />
                        <TextBlock Grid.Column="1" Style="{StaticResource BodyTextStyle}"
                                   Text="Вибравши пляму квартири перейдіть у вкладку Банк квартир, що відкрилась, та виберіть планування або віддайте вибір планування скрипту через кнопку автоматичного розпланування та для запуску скрипта натисніть на кнопку Запустити справа знизу." />
                    </Grid>
                    <!-- Three columns with a divider between them: the scheme | the buttons | the types (a circle of the group's colour and
                         what the group is; the footprints of the group have that colour on the scheme). No scroll bar: the scheme is
                         shrunk to fit (`_draw_scheme`). -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ItemsControl Grid.Column="0" x:Name="AvailableGroupsList" />
                        <Border x:Name="SchemeDividerLeft" Grid.Column="1" Width="1" Background="#C8CBCF" Margin="18,0,0,0" />
                        <!-- The buttons (their top margin is set from code to the top edge of the plan: `_draw_scheme`). "Автоматичний вибір планування
                             для решти плям" is always there (every footprint with no layout confirmed); the others only while footprints are
                             chosen: "Автоматичний вибір планувань" (the chosen ones only), "Вибрати решту плям цього типу", and - when a
                             footprint that already has its layout is chosen - "Очистити". -->
                        <StackPanel x:Name="SchemeSidePanel" Grid.Column="2" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="18,0,0,0">
                            <!-- (a wider gap under it: the buttons below it come only while footprints are chosen) -->
                            <Button x:Name="AutoPickPlansButton" Content="Автоматичний вибір планування для решти плям"
                                    Style="{StaticResource FlashActionButtonStyle}" Padding="18,9"
                                    HorizontalAlignment="Stretch" Margin="0,0,0,32" />
                            <Button x:Name="AutoPickChosenButton" Content="Автоматичний вибір планувань"
                                    Style="{StaticResource FlashActionButtonStyle}" Padding="18,9"
                                    HorizontalAlignment="Stretch" Margin="0,0,0,10" Visibility="Collapsed" />
                            <Button x:Name="SelectTypeButton" Content="Вибрати решту плям цього типу"
                                    Style="{StaticResource FlashActionButtonStyle}" Padding="18,9"
                                    HorizontalAlignment="Stretch" Margin="0,0,0,10" Visibility="Collapsed" />
                            <Button x:Name="ClearChoiceButton" Content="Очистити"
                                    Style="{StaticResource FlashActionButtonStyle}" Padding="18,9"
                                    HorizontalAlignment="Stretch" Margin="0,0,0,10" Visibility="Collapsed" />
                        </StackPanel>
                        <Border x:Name="SchemeDividerRight" Grid.Column="3" Width="1" Background="#C8CBCF" Margin="18,0,0,0" />
                        <StackPanel x:Name="SchemeTypesPanel" Grid.Column="4" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="18,0,0,0" Visibility="Collapsed">
                            <TextBlock Text="Квартири за типами:" Style="{StaticResource ColumnSubtitleStyle}" Margin="0,0,0,12" />
                            <ItemsControl x:Name="SchemeTypesList" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </StackPanel>

            </Expander>
            <!-- The geometry edits no longer have a stage of their own: they run by themselves right after a floor is laid out
                 (`_run_geometry_after_floor`). The elements stay (hidden) because the code still reads them. -->
            <Border Height="1" Background="#C8CBCF" Margin="0,22,0,22" Visibility="Collapsed" />
            <Expander x:Name="GeometryExpander" Style="{StaticResource SectionExpanderStyle}" IsExpanded="False" Visibility="Collapsed">
                <Expander.Header>
                    <StackPanel>
                        <TextBlock Text="3. Редагування геометрії" Style="{StaticResource ColumnTitleStyle}" />
                        <TextBlock Text="Дотягнення геометрії квартири до меж плями" TextWrapping="Wrap" Style="{StaticResource ColumnSubtitleStyle}" Margin="0,3,0,0" />
                    </StackPanel>
                </Expander.Header>
            <StackPanel Margin="28,6,0,24" Grid.IsSharedSizeScope="True">
                <Grid Margin="0,10,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Ellipse Grid.Column="0" Width="4" Height="4" Margin="2,8,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"
                             Fill="{StaticResource AvrTextMutedBrush}" />
                    <TextBlock Grid.Column="1" Style="{StaticResource BodyTextStyle}"
                               Text="Для дотягнення геометрії натисніть кнопку Запустити." />
                </Grid>
                <!-- Only the two edits: the tick boxes beside them show once an apartment is placed on the floor (both ticked);
                     they work on every apartment of the floor, "Запустити" (bottom right) runs them. -->
                <Grid HorizontalAlignment="Left">
                    <Grid.ColumnDefinitions><ColumnDefinition SharedSizeGroup="EditButtons" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <Button x:Name="ExtendExternalWallsButton" Content="Вирівнювання зовнішніх стін квартири до меж плями"
                            Style="{StaticResource FlashActionButtonStyle}" Padding="18,9" />
                    <CheckBox x:Name="ExtendExternalWallsCheck" Grid.Column="1" IsChecked="True" Margin="14,0,0,0" VerticalAlignment="Center" Visibility="Collapsed" />
                </Grid>
                <!-- One combined step. The button itself is not clickable: it only runs with
                     "Запустити" once apartments are picked, approved (ticked) by default. -->
                <Grid HorizontalAlignment="Left" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition SharedSizeGroup="EditButtons" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <Button x:Name="GeometryFixButton" Content="Виправлення геометрії квартири та додавання сходово-ліфтового вузла"
                            Style="{StaticResource FlashActionButtonStyle}" Padding="18,9"
                            IsHitTestVisible="False" Focusable="False" />
                    <CheckBox x:Name="GeometryFixCheck" Grid.Column="1" IsChecked="True" Margin="14,0,0,0" VerticalAlignment="Center" Visibility="Collapsed" />
                </Grid>
                <!-- FLOORS (section mode only: the active view is one of the views made for chosen sections), below everything that is about apartments:
                     the floors that are completely laid out, and the button that copies the picked one to the identical floors. -->
                <StackPanel x:Name="PlacedFloorsPanel" Visibility="Collapsed">
                    <Border Height="1" Background="#ECEEEC" Margin="0,36,0,28" />
                    <TextBlock Text="Автоматичне розташування геометрії поверхів" TextWrapping="Wrap"
                               Style="{StaticResource ColumnSubtitleStyle}" Margin="0,0,0,28" />
                    <Grid HorizontalAlignment="Left">
                        <Grid.ColumnDefinitions><ColumnDefinition SharedSizeGroup="EditButtons" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <Button x:Name="CopyFloorButton" Content="Копіювання розпланованого поверху на решту поверхів"
                                Style="{StaticResource FlashActionButtonStyle}" Padding="18,9" />
                    </Grid>
                    <TextBlock Text="Розміщені поверхи:" FontWeight="SemiBold" Margin="19,14,0,8" />
                    <ItemsControl x:Name="PlacedFloorsList" />
                </StackPanel>
            </StackPanel>
            </Expander>
        </StackPanel>
        </ScrollViewer>
        <!-- "2" open: appears as soon as one footprint has its apartment (nothing is placed until it is pressed). -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
            <Button x:Name="FloorRunButton" Content="Запустити"
                    Style="{StaticResource PrimaryActionButtonStyle}"
                    MinWidth="130" Padding="18,9" Margin="0,8,0,0"
                    VerticalAlignment="Center"
                    Visibility="Collapsed" />
            <!-- "3" open: runs the two edits that are ticked, on every apartment placed on the floor. -->
            <Button x:Name="PlacedRunButton" Content="Запустити"
                    Style="{StaticResource PrimaryActionButtonStyle}"
                    MinWidth="130" Padding="18,9" Margin="10,8,0,0"
                    VerticalAlignment="Center"
                    Visibility="Collapsed" />
        </StackPanel>
        </Grid>
    </TabItem>
    </TabControl>
    <StackPanel x:Name="CaptionButtonsPanel" Orientation="Horizontal"
                HorizontalAlignment="Right" VerticalAlignment="Top">
        <Rectangle x:Name="TabOverflowSeparator" Width="1" Height="16" Fill="#C8CBCF"
                   VerticalAlignment="Center" Margin="0,0,2,0" Visibility="Collapsed" />
        <Button x:Name="TabOverflowButton" Style="{StaticResource CaptionButtonStyle}" Content="&#xE70D;"
                Width="36" Visibility="Collapsed" ToolTip="Інші вкладки" />
        <Button x:Name="MinimizeButton" Style="{StaticResource CaptionButtonStyle}" Content="&#xE921;" />
        <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButtonStyle}" Content="&#xE922;" />
        <Button x:Name="CloseWindowButton" Style="{StaticResource CaptionCloseButtonStyle}" Content="&#xE8BB;" />
    </StackPanel>
    </Grid>
</Window>
