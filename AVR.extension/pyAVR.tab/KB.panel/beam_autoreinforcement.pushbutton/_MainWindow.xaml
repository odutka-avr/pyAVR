<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Армування балки" Height="900" Width="520"
        WindowStartupLocation="CenterScreen"
        FontSize="14">

    <Window.Resources>
        <Style x:Key="SectionBorder" TargetType="Border">
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>

        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style x:Key="SubLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#555555"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,8,0,4"/>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>

        <Style x:Key="NumBox" TargetType="TextBox">
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Width" Value="120"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>

        <Style x:Key="AddButton" TargetType="Button">
            <Setter Property="Background" Value="#E9E9E9"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,8"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">

            <!-- ================= SECTION 1: Захисний шар ================= -->
            <Border Style="{StaticResource SectionBorder}">
                <StackPanel>
                    <TextBlock Text="Захисний шар" Style="{StaticResource SectionHeader}"/>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="c top" Style="{StaticResource FieldLabel}"/>
                        <TextBox Grid.Column="1" x:Name="CTopBox" Style="{StaticResource NumBox}" Text="30"/>
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="c bottom" Style="{StaticResource FieldLabel}"/>
                        <TextBox Grid.Column="1" x:Name="CBottomBox" Style="{StaticResource NumBox}" Text="30"/>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="c side" Style="{StaticResource FieldLabel}"/>
                        <TextBox Grid.Column="1" x:Name="CSideBox" Style="{StaticResource NumBox}" Text="30"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ================= SECTION 2: Нижня поздовжня арматура ================= -->
            <Border Style="{StaticResource SectionBorder}">
                <StackPanel>
                    <TextBlock Text="Нижня поздовжня арматура" Style="{StaticResource SectionHeader}"/>

                    <TextBlock Text="Ліва грань" Style="{StaticResource SubLabel}" Margin="0,0,0,4"/>
                    <StackPanel x:Name="LowerRebarsPanel"/>
                    <!-- <Button x:Name="AddLowerLeftBtn" Content="Додати стержень" Style="{StaticResource AddButton}" Click="AddLowerLeft_Click"/> -->

                    <TextBlock Text="Права грань" Style="{StaticResource SubLabel}"/>
                    <!-- <StackPanel x:Name="LowerRightPanel"/> -->
                    <Button x:Name="AddLowerRebarBtn" Content="Додати стержень" Style="{StaticResource AddButton}" Click="AddLowerRebar_Click"/>
                </StackPanel>
            </Border>

            <!-- ================= SECTION 3: Верхня поздовжня арматура ================= -->
            <Border Style="{StaticResource SectionBorder}">
                <StackPanel>
                    <TextBlock Text="Верхня поздовжня арматура" Style="{StaticResource SectionHeader}"/>

                    <TextBlock Text="Ліва грань" Style="{StaticResource SubLabel}" Margin="0,0,0,4"/>
                    <StackPanel x:Name="UpperRebarsPanel"/>
                    <!-- <Button x:Name="AddUpperLeftBtn" Content="Додати стержень" Style="{StaticResource AddButton}" Click="AddUpperLeft_Click"/> -->

                    <TextBlock Text="Права грань" Style="{StaticResource SubLabel}"/>
                    <!-- <StackPanel x:Name="UpperRightPanel"/> -->
                    <Button x:Name="AddUpperRebarBtn" Content="Додати стержень" Style="{StaticResource AddButton}" Click="AddUpperRebar_Click"/>
                </StackPanel>
            </Border>

            <!-- ================= SECTION 4: Конструктивні стержні ================= -->
            <Border Style="{StaticResource SectionBorder}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Конструктивні стержні посередині країв балки" VerticalAlignment="Center" TextWrapping="Wrap" Width="380"/>
                        <CheckBox x:Name="ConstructiveCheckBox" VerticalAlignment="Center" Margin="10,0,0,0"
                                  Checked="ConstructiveCheckBox_Checked" Unchecked="ConstructiveCheckBox_Unchecked"/>
                    </StackPanel>

                    <StackPanel x:Name="ConstructiveSideRebarListsContainer" Visibility="Collapsed" Margin="0,12,0,0">
                        <TextBlock Text="Верх" Style="{StaticResource SubLabel}" Margin="0,0,0,4"/>
                        <StackPanel x:Name="ConstructiveSideRebarPanel"/>
                        <!-- <Button x:Name="AddConstructiveTopBtn" Content="Додати стержень" Style="{StaticResource AddButton}" Click="AddConstructiveTop_Click"/> -->

                        <TextBlock Text="Низ" Style="{StaticResource SubLabel}"/>
                        <!-- <StackPanel x:Name="ConstructiveBottomPanel"/> -->
                        <Button x:Name="AddConstructiveSideRebarBtn" Content="Додати стержень" Style="{StaticResource AddButton}" Click="AddConstructiveSideRebar_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ================= SECTION 5: Хомути ================= -->
            <Border Style="{StaticResource SectionBorder}">
                <StackPanel>
                    <TextBlock Text="Хомути" Style="{StaticResource SectionHeader}"/>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Тип арматури" Style="{StaticResource FieldLabel}"/>
                        <ComboBox Grid.Column="1" x:Name="StirrupClassCombo" Width="180" HorizontalAlignment="Left"/>
                    </Grid>

                    <TextBlock Text="Крок хомутів" FontWeight="SemiBold" Margin="0,4,0,8"/>

                    <Grid Margin="20,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Прольотна зона" Style="{StaticResource FieldLabel}"/>
                        <TextBox Grid.Column="1" x:Name="SpanStepBox" Style="{StaticResource NumBox}" Text="200"/>
                    </Grid>

                    <Grid Margin="20,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Приопорна зона" Style="{StaticResource FieldLabel}"/>
                        <TextBox Grid.Column="1" x:Name="SupportStepBox" Style="{StaticResource NumBox}" Text="150"/>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <TextBlock Text="l1" Style="{StaticResource FieldLabel}" Margin="0,0,10,0"/>
                            <TextBox x:Name="L1Box" Style="{StaticResource NumBox}" Width="90" Text="150"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <TextBlock Text="l2" Style="{StaticResource FieldLabel}" Margin="0,0,10,0"/>
                            <TextBox x:Name="L2Box" Style="{StaticResource NumBox}" Width="90" Text="150"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <Button x:Name="ShowDataBtn" Content="Показати дані (JSON)" Padding="10,8" Click="ShowData_Click" Margin="0,0,0,20"/>

        </StackPanel>
    </ScrollViewer>
</Window>
