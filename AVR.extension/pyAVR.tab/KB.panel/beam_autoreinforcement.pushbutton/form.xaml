<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Армування балки" Height="900" Width="520"
        WindowStartupLocation="CenterScreen"
        FontSize="14">

    <Window.Resources>
        <Style x:Key="SectionBorder" TargetType="Border">
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>

        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style x:Key="SubLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#555555"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,8,0,4"/>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>

        <Style x:Key="NumBox" TargetType="TextBox">
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Width" Value="120"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>

        <Style x:Key="AddButton" TargetType="Button">
            <Setter Property="Background" Value="#E9E9E9"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,8"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>

        <!-- Стиль для поля "виступ за межі балки" в кожній секції армування -->
        <Style x:Key="OffsetRow" TargetType="Grid">
            <Setter Property="Margin" Value="0,14,0,0"/>
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">

            <!-- ================= SECTION 1: Захисний шар ================= -->
            <Border Style="{StaticResource SectionBorder}">
                <StackPanel>
                    <TextBlock Text="Захисний шар" Style="{StaticResource SectionHeader}"/>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Верхній" Style="{StaticResource FieldLabel}"/>
                        <TextBox Grid.Column="1" x:Name="CTopBox" Style="{StaticResource NumBox}" Text="30"/>
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Нижній" Style="{StaticResource FieldLabel}"/>
                        <TextBox Grid.Column="1" x:Name="CBottomBox" Style="{StaticResource NumBox}" Text="30"/>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Боковий" Style="{StaticResource FieldLabel}"/>
                        <TextBox Grid.Column="1" x:Name="CSideBox" Style="{StaticResource NumBox}" Text="30"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ================= SECTION 2: Нижня поздовжня арматура ================= -->
            <Border Style="{StaticResource SectionBorder}">
                <StackPanel>
                    <TextBlock Text="Нижня поздовжня арматура" Style="{StaticResource SectionHeader}"/>

                    <!-- 1.1 Кутовий стержень (симетричний, без стрілок/видалення) -->
                    <TextBlock Text="Кутовий стержень" Style="{StaticResource SubLabel}" Margin="0,0,0,4"/>
                    <ComboBox x:Name="LowerCornerRebarCombo" Width="220" HorizontalAlignment="Left"/>

                    <!-- 1.2 Чекбокс "Додати стержні між кутовими" -->
                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <TextBlock Text="Додати стержні між кутовими" VerticalAlignment="Center"/>
                        <CheckBox x:Name="LowerIntermediateCheckBox" VerticalAlignment="Center" Margin="10,0,0,0"
                                  Checked="LowerIntermediateCheckBox_Checked" Unchecked="LowerIntermediateCheckBox_Unchecked"/>
                    </StackPanel>

                    <!-- 1.3 Проміжні стержні (умовно видимі) -->
                    <StackPanel x:Name="LowerIntermediateContainer" Visibility="Collapsed" Margin="0,12,0,0">
                        <StackPanel x:Name="LowerRebarsPanel"/>
                        <Button x:Name="AddLowerRebarBtn" Content="Додати стержень" Style="{StaticResource AddButton}" Click="AddLowerRebar_Click"/>
                    </StackPanel>

                    <Grid Style="{StaticResource OffsetRow}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Виступ за межі балки, мм" Style="{StaticResource FieldLabel}" TextWrapping="Wrap"/>
                        <TextBox Grid.Column="1" x:Name="BottomOffsetBox" Style="{StaticResource NumBox}" Text="0"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ================= SECTION 3: Верхня поздовжня арматура ================= -->
            <Border Style="{StaticResource SectionBorder}">
                <StackPanel>
                    <TextBlock Text="Верхня поздовжня арматура" Style="{StaticResource SectionHeader}"/>

                    <!-- 1.1 Кутовий стержень (симетричний, без стрілок/видалення) -->
                    <TextBlock Text="Кутовий стержень" Style="{StaticResource SubLabel}" Margin="0,0,0,4"/>
                    <ComboBox x:Name="UpperCornerRebarCombo" Width="220" HorizontalAlignment="Left"/>

                    <!-- 1.2 Чекбокс "Додати стержні між кутовими" -->
                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <TextBlock Text="Додати стержні між кутовими" VerticalAlignment="Center"/>
                        <CheckBox x:Name="UpperIntermediateCheckBox" VerticalAlignment="Center" Margin="10,0,0,0"
                                  Checked="UpperIntermediateCheckBox_Checked" Unchecked="UpperIntermediateCheckBox_Unchecked"/>
                    </StackPanel>

                    <!-- 1.3 Проміжні стержні (умовно видимі) -->
                    <StackPanel x:Name="UpperIntermediateContainer" Visibility="Collapsed" Margin="0,12,0,0">
                        <StackPanel x:Name="UpperRebarsPanel"/>
                        <Button x:Name="AddUpperRebarBtn" Content="Додати стержень" Style="{StaticResource AddButton}" Click="AddUpperRebar_Click"/>
                    </StackPanel>

                    <Grid Style="{StaticResource OffsetRow}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Виступ за межі балки, мм" Style="{StaticResource FieldLabel}" TextWrapping="Wrap"/>
                        <TextBox Grid.Column="1" x:Name="TopOffsetBox" Style="{StaticResource NumBox}" Text="0"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ================= SECTION 4: Конструктивні стержні (без змін) ================= -->
            <Border Style="{StaticResource SectionBorder}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Конструктивні стержні посередині країв балки" VerticalAlignment="Center" TextWrapping="Wrap" Width="380"/>
                        <CheckBox x:Name="ConstructiveCheckBox" VerticalAlignment="Center" Margin="10,0,0,0"
                                  Checked="ConstructiveCheckBox_Checked" Unchecked="ConstructiveCheckBox_Unchecked"/>
                    </StackPanel>

                    <StackPanel x:Name="ConstructiveSideRebarListsContainer" Visibility="Collapsed" Margin="0,12,0,0">
                        <TextBlock Text="Верх" Style="{StaticResource SubLabel}" Margin="0,0,0,4"/>
                        <StackPanel x:Name="ConstructiveSideRebarPanel"/>

                        <TextBlock Text="Низ" Style="{StaticResource SubLabel}"/>
                        <Button x:Name="AddConstructiveSideRebarBtn" Content="Додати стержень" Style="{StaticResource AddButton}" Click="AddConstructiveSideRebar_Click"/>

                        <Grid Style="{StaticResource OffsetRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Виступ за межі балки, мм" Style="{StaticResource FieldLabel}" TextWrapping="Wrap"/>
                            <TextBox Grid.Column="1" x:Name="SideOffsetBox" Style="{StaticResource NumBox}" Text="0"/>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ================= SECTION 5: Хомути ================= -->
            <Border Style="{StaticResource SectionBorder}">
                <StackPanel>
                    <TextBlock Text="Хомути" Style="{StaticResource SectionHeader}"/>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Тип арматури" Style="{StaticResource FieldLabel}"/>
                        <ComboBox Grid.Column="1" x:Name="StirrupClassCombo" Width="180" HorizontalAlignment="Left"/>
                    </Grid>

                    <TextBlock Text="Крок хомутів" FontWeight="SemiBold" Margin="0,4,0,8"/>

                    <Grid Margin="20,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Прольотна зона" Style="{StaticResource FieldLabel}"/>
                        <TextBox Grid.Column="1" x:Name="SpanStepBox" Style="{StaticResource NumBox}" Text="200"/>
                    </Grid>

                    <Grid Margin="20,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Приопорна зона" Style="{StaticResource FieldLabel}"/>
                        <TextBox Grid.Column="1" x:Name="SupportStepBox" Style="{StaticResource NumBox}" Text="150"/>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <TextBlock Text="l1" Style="{StaticResource FieldLabel}" Margin="0,0,10,0"/>
                            <TextBox x:Name="L1Box" Style="{StaticResource NumBox}" Width="90" Text="150"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <TextBlock Text="l2" Style="{StaticResource FieldLabel}" Margin="0,0,10,0"/>
                            <TextBox x:Name="L2Box" Style="{StaticResource NumBox}" Width="90" Text="150"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <Button x:Name="ShowDataBtn" Content="Підтвердити" Padding="10,8" Click="PushData_Click" Margin="0,0,0,20"/>

        </StackPanel>
    </ScrollViewer>
</Window>
