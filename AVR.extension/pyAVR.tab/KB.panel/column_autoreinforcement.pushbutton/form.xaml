<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Армування колони" Height="800" Width="520"
        WindowStartupLocation="CenterScreen"
        FontSize="14">

    <Window.Resources>
        <Style x:Key="SectionBorder" TargetType="Border">
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>

        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style x:Key="SubLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#555555"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,8,0,4"/>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>

        <Style x:Key="NumBox" TargetType="TextBox">
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Width" Value="120"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>

        <Style x:Key="AddButton" TargetType="Button">
            <Setter Property="Background" Value="#E9E9E9"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,8"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="OffsetRow" TargetType="Grid">
            <Setter Property="Margin" Value="0,14,0,0"/>
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">

            <!-- ================= SECTION 1: Захисний шар ================= -->
            <Border Style="{StaticResource SectionBorder}">
                <StackPanel>
                    <TextBlock Text="Захисний шар" Style="{StaticResource SectionHeader}"/>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Верх + низ" Style="{StaticResource FieldLabel}"/>
                        <TextBox Grid.Column="1" x:Name="CVerticalBox" Style="{StaticResource NumBox}" Text="30"/>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Боки" Style="{StaticResource FieldLabel}"/>
                        <TextBox Grid.Column="1" x:Name="CSideBox" Style="{StaticResource NumBox}" Text="30"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ================= SECTION 2: Кутова арматура ================= -->
            <Border Style="{StaticResource SectionBorder}">
                <StackPanel>
                    <TextBlock Text="Кутова арматура" Style="{StaticResource SectionHeader}"/>

                    <TextBlock Text="Тип арматури" Style="{StaticResource SubLabel}" Margin="0,0,0,4"/>
                    <ComboBox x:Name="CornerRebarCombo" Width="220" HorizontalAlignment="Left"/>

                    <Grid Style="{StaticResource OffsetRow}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Виступ за межі верху балки, мм" Style="{StaticResource FieldLabel}" TextWrapping="Wrap"/>
                        <TextBox Grid.Column="1" x:Name="CornerOffsetBox" Style="{StaticResource NumBox}" Text="0"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ================= SECTION 3: Бокова додаткова арматура ================= -->
            <Border Style="{StaticResource SectionBorder}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Бокова додаткова арматура" VerticalAlignment="Center" TextWrapping="Wrap" Width="380"/>
                        <CheckBox x:Name="SideAdditionalCheckBox" VerticalAlignment="Center" Margin="10,0,0,0"
                                  Checked="SideAdditionalCheckBox_Checked" Unchecked="SideAdditionalCheckBox_Unchecked"/>
                    </StackPanel>

                    <StackPanel x:Name="SideAdditionalContainer" Visibility="Collapsed" Margin="0,12,0,0">
                        <StackPanel x:Name="SideAdditionalPanel"/>
                        <Button x:Name="AddSideAdditionalBtn" Content="Додати стержень" Style="{StaticResource AddButton}" Click="AddSideAdditionalRebar_Click"/>

                        <Grid Style="{StaticResource OffsetRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Виступ за межі верху балки, мм" Style="{StaticResource FieldLabel}" TextWrapping="Wrap"/>
                            <TextBox Grid.Column="1" x:Name="SideAdditionalOffsetBox" Style="{StaticResource NumBox}" Text="0"/>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ================= SECTION 4: Додаткова арматура знизу/зверху ================= -->
            <Border Style="{StaticResource SectionBorder}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Додаткова арматура знизу/зверху" VerticalAlignment="Center" TextWrapping="Wrap" Width="380"/>
                        <CheckBox x:Name="TopBottomAdditionalCheckBox" VerticalAlignment="Center" Margin="10,0,0,0"
                                  Checked="TopBottomAdditionalCheckBox_Checked" Unchecked="TopBottomAdditionalCheckBox_Unchecked"/>
                    </StackPanel>

                    <StackPanel x:Name="TopBottomAdditionalContainer" Visibility="Collapsed" Margin="0,12,0,0">
                        <StackPanel x:Name="TopBottomAdditionalPanel"/>
                        <Button x:Name="AddTopBottomAdditionalBtn" Content="Додати стержень" Style="{StaticResource AddButton}" Click="AddTopBottomAdditionalRebar_Click"/>

                        <Grid Style="{StaticResource OffsetRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Виступ за межі верху балки, мм" Style="{StaticResource FieldLabel}" TextWrapping="Wrap"/>
                            <TextBox Grid.Column="1" x:Name="TopBottomAdditionalOffsetBox" Style="{StaticResource NumBox}" Text="0"/>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ================= SECTION 5: Хомути ================= -->
            <Border Style="{StaticResource SectionBorder}">
                <StackPanel>
                    <TextBlock Text="Хомути" Style="{StaticResource SectionHeader}"/>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Тип арматури" Style="{StaticResource FieldLabel}"/>
                        <ComboBox Grid.Column="1" x:Name="StirrupClassCombo" Width="180" HorizontalAlignment="Left"/>
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Крок хомутів у приопорних зонах" Style="{StaticResource FieldLabel}" TextWrapping="Wrap"/>
                        <TextBox Grid.Column="1" x:Name="SupportStepBox" Style="{StaticResource NumBox}" Text="150"/>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Крок хомутів між опорними зонами" Style="{StaticResource FieldLabel}" TextWrapping="Wrap"/>
                        <TextBox Grid.Column="1" x:Name="SpanStepBox" Style="{StaticResource NumBox}" Text="200"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Button x:Name="ShowDataBtn" Content="Підтвердити" Padding="10,8" Click="PushData_Click" Margin="0,0,0,20"/>

        </StackPanel>
    </ScrollViewer>
</Window>
