<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="View &amp; Dimension Picker"
    Width="460"
    Height="540"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterScreen"
    Background="White">

    <Window.Resources>
        <!-- ListBoxItem style -->
        <Style TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="#7d7d7d"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Background" Value="Transparent"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#8ca6c0"/>
                    <Setter Property="Foreground" Value="#000000"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#cbcbcb"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ComboBoxItem style -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#000000"/>
            <Setter Property="Background" Value="#cbcbcb"/>
            <Setter Property="Padding" Value="8,4"/>
        </Style>

        <!-- Base button style -->
        <Style x:Key="BaseButton" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Width" Value="100"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="3">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CancelButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Background" Value="#2A2A2A"/>
            <Setter Property="BorderBrush" Value="#3A3A3A"/>
            <Setter Property="Foreground" Value="#9E9E9E"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#333333"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ConfirmButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Background" Value="#1976D2"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1565C0"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#37474F"/>
                    <Setter Property="Foreground" Value="#607D8B"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- title -->
            <RowDefinition Height="Auto"/>
            <!-- separator -->
            <RowDefinition Height="Auto"/>
            <!-- views label -->
            <RowDefinition Height="*"/>
            <!-- views listbox -->
            <RowDefinition Height="Auto"/>
            <!-- dim label -->
            <RowDefinition Height="Auto"/>
            <!-- combobox -->
            <RowDefinition Height="Auto"/>
            <!-- buttons -->
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock
            Grid.Row="0"
            Text="Вибір видів та типу розміру"
            Foreground="Black"
            FontSize="15"
            FontWeight="SemiBold"
            Margin="0,0,0,10"/>

        <!-- Separator -->
        <Separator
            Grid.Row="1"
            Background="#3A3A3A"
            Margin="0,0,0,14"/>

        <!-- Views label -->
        <TextBlock
            Grid.Row="2"
            Text="Поверхові плани (Ctrl+click для вибору кількох опцій)"
            FontSize="11"
            Margin="0,0,0,6"/>

        <!-- Views ListBox -->
        <ListBox
            x:Name="LbViews"
            Grid.Row="3"
            SelectionMode="Extended"
            Background="#FFEDEDED"
            BorderBrush="#3A3A3A"
            BorderThickness="1"
            Padding="4"
            Margin="0,0,0,16"
            ScrollViewer.VerticalScrollBarVisibility="Auto"
            />

        <!-- Dimension type label -->
        <TextBlock
            Grid.Row="4"
            Text="Dimension Type"
            Foreground="Black"
            FontSize="11"
            Margin="0,0,0,6"/>

        <!-- Dimension type ComboBox -->
        <ComboBox
            x:Name="CbDimType"
            Grid.Row="5"
            Background="#cccccc"
            Foreground="#000000"
            BorderBrush="#3A3A3A"
            Padding="6,4"
            Margin="0,0,0,20"/>

        <!-- Buttons -->
        <StackPanel
            Grid.Row="6"
            Orientation="Horizontal"
            HorizontalAlignment="Right">

            <Button
                x:Name="BtnCancel"
                Content="Cancel"
                Style="{StaticResource CancelButton}"
                Margin="0,0,10,0"
                 Background="#FFFFE2E2" Foreground="#FFFF7979" BorderBrush="{x:Null}"/>

            <Button
                x:Name="BtnConfirm"
                Content="Confirm"
                Style="{StaticResource ConfirmButton}"
                IsEnabled="False"
                 Background="#FFC4DAF3" Foreground="Black"/>
        </StackPanel>
    </Grid>
</Window>