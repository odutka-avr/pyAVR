<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tadpole — налаштування" Width="560" SizeToContent="Height"
        ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen"
        Background="#E9EAEC" Foreground="#171C21"
        FontFamily="Roboto, Tahoma" FontSize="13">

  <!-- AVR Design System (user, 2026-10-16): monochrome chrome - black is the only "on" colour, no accent;
       sharp 2 px corners, 1 px hairlines; Roboto for text, Roboto Condensed in capitals for labels and buttons,
       Montserrat for names; numbered black chips open the groups, a black banner opens the window.
       A font the machine does not have falls back to the next in its list. -->
  <Window.Resources>
    <SolidColorBrush x:Key="Ink" Color="#171C21"/>
    <SolidColorBrush x:Key="InkHover" Color="#242930"/>
    <SolidColorBrush x:Key="Graphite" Color="#33353D"/>
    <SolidColorBrush x:Key="Muted" Color="#5C636B"/>
    <SolidColorBrush x:Key="Faint" Color="#8F949C"/>
    <SolidColorBrush x:Key="Line" Color="#E2E4E6"/>
    <SolidColorBrush x:Key="LineStrong" Color="#C8CBCF"/>
    <SolidColorBrush x:Key="Surface" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Surface2" Color="#F4F5F6"/>
    <SolidColorBrush x:Key="Warning" Color="#8A3B2A"/>
    <FontFamily x:Key="Cond">Roboto Condensed, Arial Narrow, Tahoma</FontFamily>
    <FontFamily x:Key="Display">Montserrat, Helvetica Neue, Arial</FontFamily>

    <Style TargetType="TextBox">
      <Setter Property="Height" Value="28"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="BorderBrush" Value="{StaticResource LineStrong}"/>
      <Setter Property="Background" Value="{StaticResource Surface}"/>
      <Setter Property="Foreground" Value="{StaticResource Ink}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="box" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="1" CornerRadius="2">
              <ScrollViewer x:Name="PART_ContentHost" Margin="8,0,8,0"
                            VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource Ink}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{StaticResource Surface2}"/>
                <Setter Property="Foreground" Value="{StaticResource Faint}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- THE MOST 1K: with the switch on the shares are greyed out and half-transparent -->
    <Style x:Key="RatioBlock" TargetType="StackPanel">
      <Style.Triggers>
        <DataTrigger Binding="{Binding ElementName=cb_max1k, Path=IsChecked}" Value="True">
          <Setter Property="IsEnabled" Value="False"/>
          <Setter Property="Opacity" Value="0.4"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>


    <!-- a field's name: condensed capitals, muted -->
    <Style x:Key="Label" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource Cond}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
      <Setter Property="Margin" Value="0,12,0,4"/>
    </Style>

    <!-- the small caption over a column (1К / 2К / 3К) -->
    <Style x:Key="Caption" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource Cond}"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Foreground" Value="{StaticResource Faint}"/>
      <Setter Property="Margin" Value="0,0,0,3"/>
    </Style>

    <!-- a group's title beside its numbered chip -->
    <Style x:Key="GroupTitle" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource Cond}"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Foreground" Value="{StaticResource Ink}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Margin" Value="8,0,0,0"/>
    </Style>

    <!-- SIGNATURE: the numbered black-square chip -->
    <Style x:Key="Chip" TargetType="Border">
      <Setter Property="Width" Value="16"/>
      <Setter Property="Height" Value="16"/>
      <Setter Property="CornerRadius" Value="2"/>
      <Setter Property="Background" Value="{StaticResource Ink}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="ChipText" TargetType="TextBlock">
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="HorizontalAlignment" Value="Center"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- a panel: white surface, hairline, sharp corners -->
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource Surface}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="2"/>
      <Setter Property="Padding" Value="16"/>
      <Setter Property="Margin" Value="0,0,0,12"/>
    </Style>

    <!-- the template's checkbox (AVR Design System, CompForms): a 16 px square, a 1 px line-strong border; on, solid black
         with a white tick. Its label is its content: Roboto Condensed 13, sentence case, graphite #33353D in either
         state (user, 2026-10-16: "все аби було за шаблоном") -->
    <Style x:Key="Check" TargetType="CheckBox">
      <Setter Property="Focusable" Value="True"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontFamily" Value="{StaticResource Cond}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Foreground" Value="{StaticResource Graphite}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <StackPanel Orientation="Horizontal" Background="Transparent">
              <Border x:Name="box" Width="16" Height="16" CornerRadius="2" BorderThickness="1"
                      BorderBrush="{StaticResource LineStrong}" Background="{StaticResource Surface}"
                      VerticalAlignment="Center">
                <Path x:Name="tick" Data="M 3.5,8 L 6.5,11 L 12.5,4.5" Stroke="White" StrokeThickness="2"
                      Visibility="Collapsed"/>
              </Border>
              <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource Ink}"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="box" Property="Background" Value="{StaticResource Ink}"/>
                <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource Ink}"/>
                <Setter TargetName="tick" Property="Visibility" Value="Visible"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- buttons: condensed capitals, sharp; the primary one solid black -->
    <Style x:Key="Ghost" TargetType="Button">
      <Setter Property="FontFamily" Value="{StaticResource Cond}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="{StaticResource Ink}"/>
      <Setter Property="Background" Value="{StaticResource Surface}"/>
      <Setter Property="BorderBrush" Value="{StaticResource LineStrong}"/>
      <Setter Property="Height" Value="30"/>
      <Setter Property="Padding" Value="14,0,14,0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bg" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                    CornerRadius="2" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bg" Property="Background" Value="{StaticResource Surface2}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{StaticResource Faint}"/>
                <Setter TargetName="bg" Property="BorderBrush" Value="{StaticResource Line}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource Ghost}">
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="Background" Value="{StaticResource Ink}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Ink}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bg" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                    CornerRadius="2" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bg" Property="Background" Value="{StaticResource InkHover}"/>
                <Setter TargetName="bg" Property="BorderBrush" Value="{StaticResource InkHover}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- the sections' expander: the whole header is the toggle, a sign on the right says open or shut -->
    <Style x:Key="Fold" TargetType="Expander">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Expander">
            <DockPanel>
              <ToggleButton DockPanel.Dock="Top" Cursor="Hand"
                            IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="ToggleButton">
                    <DockPanel Background="Transparent">
                      <TextBlock x:Name="sign" DockPanel.Dock="Right" Text="+" FontSize="16"
                                 Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                      <ContentPresenter Content="{Binding Header, RelativeSource={RelativeSource AncestorType=Expander}}"
                                        VerticalAlignment="Center"/>
                    </DockPanel>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsChecked" Value="True">
                        <Setter TargetName="sign" Property="Text" Value="–"/>
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </ToggleButton.Template>
              </ToggleButton>
              <ContentPresenter x:Name="body" Visibility="Collapsed"/>
            </DockPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsExpanded" Value="True">
                <Setter TargetName="body" Property="Visibility" Value="Visible"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <DockPanel>

    <!-- SIGNATURE: the black banner, white capitals at the right edge -->
    <Border DockPanel.Dock="Top" Background="{StaticResource Ink}" Padding="16,9,16,9">
      <DockPanel>
        <TextBlock Text="Tadpole" FontFamily="{StaticResource Display}" FontWeight="SemiBold"
                   FontSize="15" Foreground="White" VerticalAlignment="Center"/>
        <TextBlock Text="НАЛАШТУВАННЯ ЗАПУСКУ" FontFamily="{StaticResource Cond}" FontSize="13"
                   Foreground="White" HorizontalAlignment="Right" VerticalAlignment="Center"/>
      </DockPanel>
    </Border>

    <Border DockPanel.Dock="Bottom" Background="{StaticResource Surface}"
            BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0"
            Padding="16,10,16,10">
      <DockPanel>
        <TextBlock x:Name="tb_status" DockPanel.Dock="Left" FontSize="11"
                   Foreground="{StaticResource Faint}"
                   VerticalAlignment="Center"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button x:Name="btn_reset" Content="СКИНУТИ" Style="{StaticResource Ghost}"
                  MinWidth="96" Margin="0,0,8,0" Click="reset_click"/>
          <Button x:Name="btn_ok" Content="ПРОДОВЖИТИ" Style="{StaticResource Primary}"
                  MinWidth="132" Click="ok_click"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- the window is as tall as what it holds: no scroll bar, nothing to drag (user, 2026-10-16) -->
    <Border Padding="16,16,16,4">
      <StackPanel>

        <Border Style="{StaticResource Card}">
          <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
              <Border Style="{StaticResource Chip}"/>
              <TextBlock Text="ЗАГАЛЬНІ" Style="{StaticResource GroupTitle}"/>
            </StackPanel>

            <TextBlock Text="ІНСОЛЯЦІЯ, ГОД (1.0 – 3.0)" Style="{StaticResource Label}"/>
            <TextBox x:Name="tb_insolation"/>

            <StackPanel x:Name="ratio_block" Style="{StaticResource RatioBlock}">
            <TextBlock Text="СПІВВІДНОШЕННЯ, % (СУМА = 100)" Style="{StaticResource Label}"/>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0">
                <TextBlock Text="1К" Style="{StaticResource Caption}"/>
                <TextBox x:Name="tb_r1"/>
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="2К" Style="{StaticResource Caption}"/>
                <TextBox x:Name="tb_r2"/>
              </StackPanel>
              <StackPanel Grid.Column="4">
                <TextBlock Text="3К" Style="{StaticResource Caption}"/>
                <TextBox x:Name="tb_r3"/>
              </StackPanel>
            </Grid>
            </StackPanel>

            <CheckBox x:Name="cb_max1k" Style="{StaticResource Check}" Margin="0,14,0,0"
                      HorizontalAlignment="Left"
                      Content="Максимально 1к — без коригування за відсотками"/>

            <TextBlock Text="ДІАПАЗОНИ ПЛОЩ, М² (НАПР. 36-50)" Style="{StaticResource Label}"/>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0">
                <TextBlock Text="1К" Style="{StaticResource Caption}"/>
                <TextBox x:Name="tb_a1"/>
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="2К" Style="{StaticResource Caption}"/>
                <TextBox x:Name="tb_a2"/>
              </StackPanel>
              <StackPanel Grid.Column="4">
                <TextBlock Text="3К" Style="{StaticResource Caption}"/>
                <TextBox x:Name="tb_a3"/>
              </StackPanel>
            </Grid>
          </StackPanel>
        </Border>

        <!-- THE SECTIONS (module, stairs side, smaller/larger flats) are out of the window for now (user,
             2026-10-16: "поки збережи в пам'яті, але з UI його варто забрати"): every section runs on the
             defaults. settings_ui.SHOW_SECTIONS brings them back -->
        <Border x:Name="card_sections" Style="{StaticResource Card}" Visibility="Collapsed">
          <Expander x:Name="exp_sections" IsExpanded="False" Style="{StaticResource Fold}">
            <Expander.Header>
              <StackPanel Orientation="Horizontal">
                <Border Style="{StaticResource Chip}">
                  <TextBlock Text="02" Style="{StaticResource ChipText}"/>
                </Border>
                <TextBlock Text="СЕКЦІЇ" Style="{StaticResource GroupTitle}"/>
                <TextBlock x:Name="tb_sections_note" FontSize="11"
                           Foreground="{StaticResource Faint}"
                           Margin="12,0,0,0" VerticalAlignment="Center"/>
              </StackPanel>
            </Expander.Header>
            <StackPanel x:Name="sections_panel" Margin="0,12,0,0"/>
          </Expander>
        </Border>

        <TextBlock x:Name="tb_errors" Foreground="{StaticResource Warning}"
                   TextWrapping="Wrap" Margin="2,0,0,8"/>

      </StackPanel>
    </Border>

  </DockPanel>
</Window>
