<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tadpole — сходова на сонячний бік" Width="600" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner" Topmost="True"
        Background="#E9EAEC" Foreground="#171C21" FontFamily="Roboto, Tahoma" FontSize="13">

  <!-- THE WARNING BEFORE A NORTH-SOUTH SECTION'S CORE GOES ACROSS (user, 2026-10-19: "з певним попередженням, що
       квартири точно стануть гірші"): which sections, from which side to which, and their flats before and after -->
  <Window.Resources>
    <SolidColorBrush x:Key="Ink" Color="#171C21"/>
    <SolidColorBrush x:Key="InkHover" Color="#242930"/>
    <SolidColorBrush x:Key="Graphite" Color="#33353D"/>
    <SolidColorBrush x:Key="Muted" Color="#5C636B"/>
    <SolidColorBrush x:Key="Faint" Color="#8F949C"/>
    <SolidColorBrush x:Key="Line" Color="#E2E4E6"/>
    <SolidColorBrush x:Key="LineStrong" Color="#C8CBCF"/>
    <SolidColorBrush x:Key="Surface" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Surface2" Color="#F4F5F6"/>
    <FontFamily x:Key="Cond">Roboto Condensed, Arial Narrow, Tahoma</FontFamily>
    <FontFamily x:Key="Display">Montserrat, Helvetica Neue, Arial</FontFamily>

    <Style x:Key="Chip" TargetType="Border">
      <Setter Property="Width" Value="16"/>
      <Setter Property="Height" Value="16"/>
      <Setter Property="CornerRadius" Value="2"/>
      <Setter Property="Background" Value="{StaticResource Ink}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="ChipText" TargetType="TextBlock">
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="HorizontalAlignment" Value="Center"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="GroupTitle" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource Cond}"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Foreground" Value="{StaticResource Ink}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Margin" Value="8,0,0,0"/>
    </Style>
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource Surface}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="2"/>
      <Setter Property="Padding" Value="16"/>
    </Style>

    <!-- the template's checkbox: a 16 px square, black with a white tick when on -->
    <Style x:Key="Check" TargetType="CheckBox">
      <Setter Property="Focusable" Value="True"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontFamily" Value="{StaticResource Cond}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Foreground" Value="{StaticResource Graphite}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <StackPanel Orientation="Horizontal" Background="Transparent">
              <Border x:Name="box" Width="16" Height="16" CornerRadius="2" BorderThickness="1"
                      BorderBrush="{StaticResource LineStrong}" Background="{StaticResource Surface}"
                      VerticalAlignment="Center">
                <Path x:Name="tick" Data="M 3.5,8 L 6.5,11 L 12.5,4.5" Stroke="White" StrokeThickness="2"
                      Visibility="Collapsed"/>
              </Border>
              <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource Ink}"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="box" Property="Background" Value="{StaticResource Ink}"/>
                <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource Ink}"/>
                <Setter TargetName="tick" Property="Visibility" Value="Visible"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Ghost" TargetType="Button">
      <Setter Property="FontFamily" Value="{StaticResource Cond}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="{StaticResource Ink}"/>
      <Setter Property="Background" Value="{StaticResource Surface}"/>
      <Setter Property="BorderBrush" Value="{StaticResource LineStrong}"/>
      <Setter Property="Height" Value="30"/>
      <Setter Property="Padding" Value="14,0,14,0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bg" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                    CornerRadius="2" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bg" Property="Background" Value="{StaticResource Surface2}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource Ghost}">
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="Background" Value="{StaticResource Ink}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Ink}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bg" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                    CornerRadius="2" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bg" Property="Background" Value="{StaticResource InkHover}"/>
                <Setter TargetName="bg" Property="BorderBrush" Value="{StaticResource InkHover}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- a folded card: the header a whole-width button with a chevron, the body shown when it is open -->
    <Style x:Key="Fold" TargetType="Expander">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Expander">
            <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                    CornerRadius="2">
              <DockPanel>
                <ToggleButton DockPanel.Dock="Top" Content="{TemplateBinding Header}" Cursor="Hand" Focusable="False"
                              IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                  <ToggleButton.Template>
                    <ControlTemplate TargetType="ToggleButton">
                      <Border x:Name="head" Background="Transparent" Padding="16,14,16,14">
                        <DockPanel>
                          <TextBlock x:Name="chev" DockPanel.Dock="Right" Text="▾" FontFamily="Segoe UI Symbol"
                                     FontSize="14" Foreground="{StaticResource Graphite}" VerticalAlignment="Center"/>
                          <ContentPresenter VerticalAlignment="Center"/>
                        </DockPanel>
                      </Border>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                          <Setter TargetName="chev" Property="Text" Value="▴"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                          <Setter TargetName="head" Property="Background" Value="{StaticResource Surface2}"/>
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </ToggleButton.Template>
                </ToggleButton>
                <ContentPresenter x:Name="body" Margin="16,0,16,16" Visibility="Collapsed"/>
              </DockPanel>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsExpanded" Value="True">
                <Setter TargetName="body" Property="Visibility" Value="Visible"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <DockPanel>
    <Border DockPanel.Dock="Top" Background="{StaticResource Ink}" Padding="16,9,16,9">
      <DockPanel>
        <TextBlock Text="Tadpole" FontFamily="{StaticResource Display}" FontWeight="SemiBold"
                   FontSize="15" Foreground="White" VerticalAlignment="Center"/>
        <TextBlock Text="СХОДОВА НА СОНЯЧНИЙ БІК" FontFamily="{StaticResource Cond}" FontSize="13"
                   Foreground="White" HorizontalAlignment="Right" VerticalAlignment="Center"/>
      </DockPanel>
    </Border>
    <Border DockPanel.Dock="Bottom" Background="{StaticResource Surface}"
            BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="16,10,16,10">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button x:Name="btn_back" Content="ПОВЕРНУТИСЯ" Style="{StaticResource Ghost}"
                MinWidth="130" Margin="0,0,8,0" Click="back_click"/>
        <Button x:Name="btn_go" Content="ЗАСТОСУВАТИ ВСЕ ОДНО" Style="{StaticResource Primary}"
                MinWidth="190" Click="go_click"/>
      </StackPanel>
    </Border>
    <Border Style="{StaticResource Card}" Margin="16,16,16,16">
      <StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
          <Border Width="18" Height="18" CornerRadius="2" BorderBrush="{StaticResource Ink}" BorderThickness="1.5"
                  Background="White" VerticalAlignment="Center">
            <TextBlock Text="!" FontFamily="{StaticResource Cond}" FontWeight="Bold" FontSize="13"
                       Foreground="{StaticResource Ink}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <TextBlock Text="МОЖНА, АЛЕ НЕ РЕКОМЕНДУЄТЬСЯ" Style="{StaticResource GroupTitle}"/>
        </StackPanel>
        <TextBlock TextWrapping="Wrap" FontFamily="{StaticResource Cond}" FontSize="13"
                   Foreground="{StaticResource Graphite}" Margin="0,0,0,12"
                   Text="Сходову переставити можна, але не рекомендується: у цих секціях довгі сторони дивляться на північ і південь, і сходова займе на сонячному боці місце квартир, яким там було найкраще."/>
        <StackPanel x:Name="warn_rows"/>
      </StackPanel>
    </Border>
  </DockPanel>
</Window>
